local function safeAddTab(name, fn)
    for attempt = 1, 25 do
        if LOOP_STOP then return false end
        local okGet, addTab = pcall(function() return rawget(UI, "AddTab") end)
        if okGet and type(addTab) == "function" then
            local ok, err = pcall(addTab, name, fn)
            if ok then print(">>> registered tab '" .. name .. "'"); return true end
            print(">>> attempt " .. attempt .. " failed: " .. tostring(err))
        end
        task.wait(0.2)
    end
    warn("[^.^meg NFC] Could not register tab: " .. name)
    return false
end

