local env = (getgenv and getgenv()) or _G
if env.__MEG_NFC_CLEANUP then pcall(env.__MEG_NFC_CLEANUP) end

local STOPPED = false
local LOOP_STOP = false

-- Constants
local COLORS = {
    species    = Color3.fromRGB(200, 160, 255),
    name       = Color3.fromRGB(255, 255, 255),
    bloodline  = Color3.fromRGB(80, 160, 255),
    spell      = Color3.fromRGB(255, 140, 0),
    invisible  = Color3.fromRGB(255, 80, 80),
    health     = Color3.fromRGB(80, 255, 80),
    distance   = Color3.fromRGB(255, 255, 255),
}

local LINE_SIZES = {
    species = 13, name = 14, bloodline = 13, spell = 13,
    visible = 13, health = 13, dist = 12,
}

local MAX_TRACKED          = 50
local OBJECT_IDLE_TIMEOUT  = 120
local DATA_INTERVAL        = 0.12
local HIDDEN_INTERVAL      = 0.5
local MAX_REFRESH_PER_FRAME = 4
local GUI_RETRY_INTERVAL   = 1.0
local TITLE_REREAD_INTERVAL = 1.0
local UI_REFRESH_INTERVAL  = 1.5

-- Services & Globals
local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera      = workspace.CurrentCamera

local floor, max, clamp, sqrt, random = math.floor, math.max, math.clamp, math.sqrt, math.random
local Vector2_new = Vector2.new
local tick = tick
local rawget = rawget

-- State
local flags = {
    enabled   = false,
    name      = true,
    bloodline = true,
    species   = true,
    health    = true,
    distance  = true,
    spellESP  = true,
    visESP    = true,
    maxDist   = 2000,
}

local trackedPlayers = {}
local trackedCount   = 0
local espObjects     = {}
local espState       = {}
local connections    = {}
local renderConn     = nil
local playerListDirty = false

-- UI State
local uiDropdown = nil
local uiSelectedPlayer = nil
local uiRebuilding = false
local uiLastDetails = {}
local lastPlayerListKey = ""

-- ------------------------------------------------------------
-- Helpers
-- ------------------------------------------------------------

local function uiSet(key, value)
    if not UI then return end
    local setValue = rawget(UI, "SetValue")
    if setValue then setValue(key, value) end
end

local function getState(player)
    local st = espState[player]
    if not st then
        st = {
            hidden = true, alive = false,
            px = {}, py = {}, col = {}, txt = {}, vis = {},
            lastSeen = tick(),
            nextData = 0, guiRetry = 0, castRetry = 0, nextTitle = 0,
        }
        espState[player] = st
    end
    return st
end

local function disconnectAll()
    if renderConn then renderConn:Disconnect(); renderConn = nil end
    for _, c in ipairs(connections) do c:Disconnect() end
    connections = {}
end

-- ------------------------------------------------------------
-- Config
-- ------------------------------------------------------------

local CONFIG_FILE = "^.^meg_config.json"

local function saveConfig()
    local lines = {}
    for k, v in pairs(flags) do
        if k ~= "enabled" then
            if type(v) == "boolean" then
                lines[#lines+1] = k .. "=B:" .. tostring(v)
            elseif type(v) == "number" then
                lines[#lines+1] = k .. "=N:" .. tostring(v)
            end
        end
    end
    writefile(CONFIG_FILE, table.concat(lines, "\n"))
end

local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local raw = readfile(CONFIG_FILE)
    if not raw or raw == "" then return end
    for line in raw:gmatch("[^\r\n]+") do
        local key, tag, val = line:match("^([^=]+)=([BN]):(.+)$")
        if key and key ~= "enabled" and flags[key] ~= nil then
            if tag == "B" and type(flags[key]) == "boolean" then
                flags[key] = (val == "true")
            elseif tag == "N" and type(flags[key]) == "number" then
                local n = tonumber(val)
                if n and n == n then
                    if key == "maxDist" then n = clamp(n, 100, 10000) end
                    flags[key] = n
                end
            end
        end
    end
end

pcall(loadConfig)

local savePending = false
local function scheduleSave()
    if savePending or LOOP_STOP then return end
    savePending = true
    task.spawn(function()
        task.wait(0.4)
        savePending = false
        if not LOOP_STOP then pcall(saveConfig) end
    end)
end

-- ------------------------------------------------------------
-- Drawing objects
-- ------------------------------------------------------------

local ESP_FONT = Drawing.Fonts.SystemBold

local function newText(size)
    local t = Drawing.new("Text")
    t.Size = size or 14
    t.Center = true
    t.Outline = true
    t.Font = ESP_FONT
    t.Visible = false
    return t
end

local lineMeta = {
    __index = function(t, key)
        local size = LINE_SIZES[key]
        if not size then return nil end
        local d = newText(size)
        rawset(t, key, d)
        return d
    end,
}

local function removeAll(tbl)
    if not tbl then return end
    for _, d in pairs(tbl) do
        if d and d.Remove then pcall(d.Remove, d) end
    end
end

local function resetCaches(st)
    st.px = {}; st.py = {}
    st.col = {}; st.txt = {}; st.vis = {}
end

local function createObjects(player)
    local objs = setmetatable({}, lineMeta)
    espObjects[player] = objs
    local st = espState[player]
    if st then resetCaches(st) end
    return objs
end

local function removeObjects(player)
    removeAll(espObjects[player])
    espObjects[player] = nil
    local st = espState[player]
    if st then
        resetCaches(st)
        st.hidden = true
    end
end

local function trackPlayer(player)
    if player == LocalPlayer or trackedPlayers[player] or trackedCount >= MAX_TRACKED then return end
    trackedPlayers[player] = true
    trackedCount = trackedCount + 1
end

local function removeESP(player)
    removeObjects(player)
    if trackedPlayers[player] then
        trackedPlayers[player] = nil
        trackedCount = trackedCount - 1
    end
    espState[player] = nil
end

-- ------------------------------------------------------------
-- Player tracking
-- ------------------------------------------------------------

for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end

pcall(function()
    connections[#connections+1] = Players.PlayerAdded:Connect(function(p)
        trackPlayer(p)
        playerListDirty = true
    end)
end)

pcall(function()
    connections[#connections+1] = Players.PlayerRemoving:Connect(function(p)
        removeESP(p)
        playerListDirty = true
    end)
end)

task.spawn(function()
    while not LOOP_STOP do
        task.wait(2)
        if LOOP_STOP then break end
        local ok, list = pcall(function() return Players:GetPlayers() end)
        if ok and list then
            local seen = {}
            for _, p in ipairs(list) do
                seen[p] = true
                if p ~= LocalPlayer and not trackedPlayers[p] then trackPlayer(p) end
            end
            for p in pairs(trackedPlayers) do
                if not seen[p] then removeESP(p) end
            end
        end
        local now = tick()
        for player in pairs(espObjects) do
            local st = espState[player]
            if st and st.hidden and st.lastSeen and (now - st.lastSeen) > OBJECT_IDLE_TIMEOUT then
                removeObjects(player)
            end
        end
    end
end)

-- ------------------------------------------------------------
-- Game data lookups
-- ------------------------------------------------------------

local livingThingsCache = nil

local function getLivingThings()
    local lt = livingThingsCache
    if lt and lt.Parent then return lt end
    lt = workspace:FindFirstChild("LivingThings")
    livingThingsCache = lt
    return lt
end

local function getLivingEntry(player)
    local lt = getLivingThings()
    return lt and lt:FindFirstChild(player.Name)
end

local function getCastingFolder(player)
    local entry = getLivingEntry(player)
    return entry and entry:FindFirstChild("CastingSpells")
end

local function getTitlesGui(character)
    if not character then return nil end
    local head = character:FindFirstChild("Head")
    if head then
        local titleAtt = head:FindFirstChild("TitleAtt")
        if titleAtt then
            local gui = titleAtt:FindFirstChild("TitlesGui")
            if gui then return gui end
        end
    end
    local lt = getLivingThings()
    if lt then
        local entry = lt:FindFirstChild(character.Name)
        if entry then
            local titleAtt = entry:FindFirstChild("TitleAtt")
            if titleAtt then
                local gui = titleAtt:FindFirstChild("TitlesGui")
                if gui then return gui end
            end
            local gui = entry:FindFirstChild("TitlesGui")
            if gui then return gui end
        end
    end
    return nil
end

local function getCharacterBloodline(character, gui, player)
    if not gui then return nil end
    local label = gui:FindFirstChild("DisplayName")
    if not (label and label:IsA("TextLabel")) then return nil end

    local text = label.Text
    if not text or text == "" then return nil end

    local first, bloodline = text:match("^(%S+)%s+(.+)$")
    if not bloodline or bloodline == "" then return nil end

    bloodline = bloodline:gsub("%s+$", "")
    if bloodline == "" then return nil end
    if first and first:lower() == bloodline:lower() then return nil end
    if player and bloodline:lower() == player.Name:lower() then return nil end

    return bloodline
end

local SPECIES_LABELS = { "SPECIE", "Specie", "Species", "SPECIES" }

local function getSpeciesText(character, gui)
    gui = gui or getTitlesGui(character)
    if gui then
        for i = 1, #SPECIES_LABELS do
            local label = gui:FindFirstChild(SPECIES_LABELS[i])
            if label and label:IsA("TextLabel") then
                local text = label.Text
                if text and text ~= "" then return text end
            end
        end
    end
    return nil
end

local function flagOn(folder, name)
    local f = folder:FindFirstChild(name)
    return f and f:IsA("BoolValue") and f.Value == true
end

local function findActiveSpells(casting)
    local ictus = flagOn(casting, "Ictus")
    local motus = flagOn(casting, "Motus")
    if ictus and motus then return "Casting : Ictus, Motus" end
    if ictus then return "Casting : Ictus" end
    if motus then return "Casting : Motus" end
    return nil
end

local function isInvisible(casting)
    return flagOn(casting, "Invisique")
end

local function isSoulLinked(player)
    local entry = getLivingEntry(player)
    if not entry then return false end
    local sl = entry:FindFirstChild("SoulLink")
    return sl and sl:IsA("BoolValue") and sl.Value == true
end

local function findSoulPartner(player)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p ~= player and isSoulLinked(p) then
            return p
        end
    end
    return nil
end

-- ------------------------------------------------------------
-- Rendering
-- ------------------------------------------------------------

-- hideAll now hides EVERY drawing object unconditionally and
-- resyncs st.vis to false. This is the core fix: never trust
-- st.vis alone, always force the real Visible=false.
local function hideAll(st, obj)
    for key, d in pairs(obj) do
        if d then pcall(function() d.Visible = false end) end
    end
    -- wipe cache so the next show always re-applies position/color/text
    st.vis = {}
    st.px = {}; st.py = {}
    st.col = {}; st.txt = {}
end

local function hideLine(st, obj, key)
    local d = rawget(obj, key)
    if d and d.Visible then d.Visible = false end
    st.vis[key] = false
end

-- Always hide, no short-circuit. Cheap and idempotent.
local function hidePlayer(player, st)
    local obj = espObjects[player]
    if obj then hideAll(st, obj) end
    st.hidden = true
end

-- Force-hide every player's objects. Used when disabled / cleanup.
local function hideAllPlayers()
    for player, obj in pairs(espObjects) do
        local st = espState[player]
        if st then
            hideAll(st, obj)
            st.hidden = true
        else
            removeAll(obj)
        end
    end
end

-- Reads position safely (instance may be destroyed mid-frame)
local function readPos(part) return part.Position end

-- All the SLOW instance reads live here. Runs staggered per player,
-- never for every player in the same frame.
local function refreshData(player, st, now)
    local char = player.Character

    if char ~= st.char then
        st.char = char
        st.hrp, st.humanoid, st.gui, st.casting, st.lastGui = nil, nil, nil, nil, nil
        st.speciesText, st.bloodline, st.spellText, st.hpText = nil, nil, nil, nil
        st.distText = nil
        st.isInvis = false
        st.lastHp, st.lastMaxHp = nil, nil
        st.guiRetry, st.castRetry, st.nextTitle = 0, 0, 0
    end

    if not char then st.alive = false; return end

    local hrp = st.hrp
    if not (hrp and hrp.Parent) then
        hrp = char:FindFirstChild("HumanoidRootPart")
        st.hrp = hrp
    end
    local humanoid = st.humanoid
    if not (humanoid and humanoid.Parent) then
        humanoid = char:FindFirstChildOfClass("Humanoid")
        st.humanoid = humanoid
    end

    if not (hrp and humanoid) then st.alive = false; return end

    local health, maxHealth = humanoid.Health, humanoid.MaxHealth
    st.alive = health > 0
    if not st.alive then return end

    -- distance text (updated at data rate, not every frame -> far fewer Text writes)
    local d = floor(st.dist or 0)
    if d ~= st.lastDist then
        st.lastDist = d
        st.distText = tostring(d)
    end

    -- health
    if maxHealth > 0 then
        local hp, mhp = floor(health), floor(maxHealth)
        if hp ~= st.lastHp or mhp ~= st.lastMaxHp then
            st.lastHp, st.lastMaxHp = hp, mhp
            st.hpText = "HP : " .. hp .. " / " .. mhp
        end
    else
        st.lastHp, st.lastMaxHp, st.hpText = nil, nil, nil
    end

    -- spells / invisible
    if flags.spellESP or flags.visESP then
        local casting = st.casting
        if not (casting and casting.Parent) then
            casting = nil
            st.casting = nil
            if now >= st.castRetry then
                casting = getCastingFolder(player)
                st.casting = casting
                if not casting then st.castRetry = now + GUI_RETRY_INTERVAL end
            end
        end
        st.spellText = (flags.spellESP and casting) and findActiveSpells(casting) or nil
        st.isInvis   = (flags.visESP and casting) and isInvisible(casting) or false
    else
        st.spellText, st.isInvis = nil, false
    end

    -- species / bloodline (re-read ~1x/sec so text changes are still picked up)
    if flags.species or flags.bloodline then
        local gui = st.gui
        if not (gui and gui.Parent) then
            gui = nil
            st.gui = nil
            if now >= st.guiRetry then
                gui = getTitlesGui(char)
                st.gui = gui
                if not gui then st.guiRetry = now + GUI_RETRY_INTERVAL end
            end
            st.nextTitle = 0
        end
        if gui and now >= st.nextTitle then
            st.nextTitle = now + TITLE_REREAD_INTERVAL
            st.speciesText = getSpeciesText(char, gui)
            st.bloodline   = getCharacterBloodline(char, gui, player)
        end
    end
end

local function showLine(st, obj, key, text, color, x, y)
    local d = obj[key]
    if st.col[key] ~= color then d.Color = color; st.col[key] = color end
    if st.txt[key] ~= text  then d.Text  = text;  st.txt[key] = text  end
    local px, py = floor(x + 0.5), floor(y + 0.5)
    if st.px[key] ~= px or st.py[key] ~= py then
        d.Position = Vector2_new(px, py)
        st.px[key] = px; st.py[key] = py
    end
    if not st.vis[key] then d.Visible = true; st.vis[key] = true end
end

local function drawPlayer(player, st, x, sy, dist, now)
    local obj = espObjects[player] or createObjects(player)

    st.hidden = false
    st.lastSeen = now
    if not st.distText then st.distText = tostring(floor(dist)) end

    local boxHeight = floor((clamp(1500 / max(dist, 1), 20, 250)) / 4) * 4
    local baseY = sy - boxHeight * 0.5 - 18
    local off = 0

    if flags.species and st.speciesText then
        showLine(st, obj, "species", st.speciesText, COLORS.species, x, baseY + off); off += 16
    else hideLine(st, obj, "species") end

    if flags.name then
        showLine(st, obj, "name", player.Name, COLORS.name, x, baseY + off); off += 17
    else hideLine(st, obj, "name") end

    if flags.bloodline and st.bloodline then
        showLine(st, obj, "bloodline", st.bloodline, COLORS.bloodline, x, baseY + off); off += 16
    else hideLine(st, obj, "bloodline") end

    if flags.spellESP and st.spellText then
        showLine(st, obj, "spell", st.spellText, COLORS.spell, x, baseY + off); off += 16
    else hideLine(st, obj, "spell") end

    if flags.visESP and st.isInvis then
        showLine(st, obj, "visible", "Invisible", COLORS.invisible, x, baseY + off); off += 16
    else hideLine(st, obj, "visible") end

    if flags.health and st.hpText then
        showLine(st, obj, "health", st.hpText, COLORS.health, x, baseY + off); off += 16
    else hideLine(st, obj, "health") end

    if flags.distance and st.distText then
        showLine(st, obj, "dist", st.distText, COLORS.distance, x, baseY + off); off += 16
    else hideLine(st, obj, "dist") end
end

local candidates = {}
local drawnThisFrame = {}   -- players we successfully drew this frame

local function renderLoop()
    if not flags.enabled then
        hideAllPlayers()
        return
    end

    if not Camera or not Camera.Parent then
        Camera = workspace.CurrentCamera
        if not Camera then hideAllPlayers(); return end
    end

    local now     = tick()
    local camPos  = Camera.CFrame.Position
    local camX, camY, camZ = camPos.X, camPos.Y, camPos.Z
    local maxDist = flags.maxDist
    local budget  = MAX_REFRESH_PER_FRAME
    local n = 0

    -- reset the per-frame drawn set
    for k in pairs(drawnThisFrame) do drawnThisFrame[k] = nil end

    -- Pass 1: cheap visibility test. Only ONE property read per player per frame (hrp.Position).
    for player in pairs(trackedPlayers) do
        local st = espState[player] or getState(player)

        if budget > 0 and now >= st.nextData then
            budget = budget - 1
            st.nextData = now + (st.hidden and HIDDEN_INTERVAL or DATA_INTERVAL) + random() * 0.04
            refreshData(player, st, now)
        end

        local visible = false
        local hrp = st.hrp
        if st.alive and hrp then
            local ok, pos = pcall(readPos, hrp)
            if ok and pos then
                local dx, dy, dz = camX - pos.X, camY - pos.Y, camZ - pos.Z
                local dist = sqrt(dx*dx + dy*dy + dz*dz)
                st.dist = dist
                if dist <= maxDist then
                    local sok, sp, onScreen = pcall(WorldToScreen, pos)
                    if sok and onScreen and sp then
                        visible = true
                        n = n + 1
                        local c = candidates[n]
                        if not c then c = {}; candidates[n] = c end
                        c.player, c.st, c.dist, c.sx, c.sy = player, st, dist, sp.X, sp.Y
                    end
                end
            end
        end

        if not visible then hidePlayer(player, st) end
    end

    for i = #candidates, n + 1, -1 do candidates[i] = nil end

    -- Pass 2: draw everyone who is on screen and in range
    for i = 1, n do
        local c = candidates[i]
        local ok = pcall(drawPlayer, c.player, c.st, c.sx, c.sy, c.dist, now)
        if ok then
            drawnThisFrame[c.player] = true
        else
            -- drawPlayer errored mid-way: force-hide so nothing is left visible
            hidePlayer(c.player, c.st)
        end
    end

    -- Pass 3: ORPHAN SWEEP. Any player in espObjects that we did NOT
    -- draw this frame gets force-hidden. This catches players removed
    -- from trackedPlayers, players whose data went stale, and any
    -- object whose st.hidden flag drifted from the real Visible.
    for player in pairs(espObjects) do
        if not drawnThisFrame[player] then
            local st = espState[player]
            if st then
                local obj = espObjects[player]
                if obj then hideAll(st, obj) end
                st.hidden = true
            else
                removeAll(espObjects[player])
            end
        end
    end
end

local renderOK = pcall(function()
    renderConn = RunService.RenderStepped:Connect(renderLoop)
end)
if not renderOK then
    task.spawn(function()
        while not LOOP_STOP do
            task.wait()
            if LOOP_STOP then break end
            pcall(renderLoop)
        end
    end)
end

-- ------------------------------------------------------------
-- Cleanup
-- ------------------------------------------------------------

env.__MEG_NFC_CLEANUP = function()
    if STOPPED then return end
    STOPPED = true
    LOOP_STOP = true
    flags.enabled = false
    hideAllPlayers()
    disconnectAll()
    for p in pairs(espObjects) do removeObjects(p) end
    espObjects, espState, trackedPlayers, trackedCount = {}, {}, {}, 0
    for k in pairs(drawnThisFrame) do drawnThisFrame[k] = nil end
end

-- ------------------------------------------------------------
-- UI Logic
-- ------------------------------------------------------------

local function entryUsername(entry)
    return entry and entry:match("%(([^%(%)]+)%)%s*$") or nil
end

local function buildPlayerList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            list[#list+1] = (p.DisplayName or p.Name) .. " (" .. p.Name .. ")"
        end
    end
    table.sort(list)
    if #list == 0 then list[1] = "(no other players)" end
    return list
end

local function findPlayerFromEntry(entry)
    local username = entryUsername(entry)
    if not username then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name == username and p ~= LocalPlayer then return p end
    end
    return nil
end

local function setDetail(key, value)
    if uiLastDetails[key] ~= value then
        uiLastDetails[key] = value
        uiSet(key, value)
    end
end

local function clearDetails()
    setDetail("nf_det_user", "-")
    setDetail("nf_det_species", "-")
    setDetail("nf_det_bloodline", "-")
    setDetail("nf_det_health", "-")
    setDetail("nf_det_soul", "-")
end

local function updateDetails()
    local sel = uiSelectedPlayer
    if not (sel and sel.Parent == Players) then
        clearDetails()
        return
    end

    local char = sel.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local gui = char and getTitlesGui(char)

    setDetail("nf_det_user", (sel.DisplayName or sel.Name) .. " (" .. sel.Name .. ")")
    setDetail("nf_det_species", (char and getSpeciesText(char, gui)) or "?")
    setDetail("nf_det_bloodline", (char and getCharacterBloodline(char, gui, sel)) or "?")

    local hpStr = "?"
    if humanoid and humanoid.MaxHealth > 0 then
        hpStr = floor(humanoid.Health) .. " / " .. floor(humanoid.MaxHealth)
    end
    setDetail("nf_det_health", hpStr)

    if isSoulLinked(sel) then
        local partner = findSoulPartner(sel)
        if partner then
            setDetail("nf_det_soul", (partner.DisplayName or partner.Name) .. " (" .. partner.Name .. ")")
        else
            setDetail("nf_det_soul", "Yes")
        end
    else
        setDetail("nf_det_soul", "-")
    end
end

-- Player list rebuild loop
task.spawn(function()
    while not LOOP_STOP do
        task.wait(1)
        if LOOP_STOP then break end
        if uiDropdown and playerListDirty then
            playerListDirty = false
            local newEntries = buildPlayerList()
            local newKey = table.concat(newEntries, "\0")

            if newKey ~= lastPlayerListKey then
                lastPlayerListKey = newKey
                local selectedName = uiSelectedPlayer and uiSelectedPlayer.Name
                local selectedIndex = -1
                if selectedName then
                    for index, entry in ipairs(newEntries) do
                        if entryUsername(entry) == selectedName then
                            selectedIndex = index - 1
                            break
                        end
                    end
                end
                if selectedIndex < 0 then
                    selectedIndex = 0
                    uiSelectedPlayer = findPlayerFromEntry(newEntries[1])
                end
                uiRebuilding = true
                pcall(function()
                    uiDropdown:Clear()
                    for _, entry in ipairs(newEntries) do uiDropdown:Add(entry) end
                    uiDropdown:SetValue(selectedIndex)
                end)
                uiRebuilding = false
            end
        end
    end
end)

task.spawn(function()
    while not LOOP_STOP do
        task.wait(UI_REFRESH_INTERVAL)
        if LOOP_STOP then break end
        pcall(updateDetails)
    end
end)

