env.__MEG_NFC_CLEANUP = function()
    if STOPPED then return end
    STOPPED = true
    LOOP_STOP = true
    flags.enabled = false
    disconnectAll()
    for p in pairs(espObjects) do removeObjects(p) end
    espObjects, espState, trackedPlayers, trackedCount = {}, {}, {}, 0
end

