-- State
local flags = {
    enabled   = false,
    name      = true,
    bloodline = true,
    species   = true,
    health    = true,
    distance  = true,
    spellESP  = true,
    visESP    = true,
    maxDist   = 2000,
}

local trackedPlayers = {}
local trackedCount   = 0
local espObjects     = {}
local espState       = {}
local connections    = {}
