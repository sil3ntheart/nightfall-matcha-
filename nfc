local function safeTeleport(targetPos, label)
    local char = LocalPlayer.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then
        NotifySafe({ title = "Teleport", content = "Character not found.", duration = 3 })
        return
    end
    local offsets = { 0, -3, 3, 6, 10, 20, -10, 50 }
    local finalPos = targetPos
    local found = false
    for _, dy in ipairs(offsets) do
        local testPos = targetPos + Vector3.new(0, dy, 0)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        local hit = workspace:Raycast(testPos + Vector3.new(0, 5, 0), Vector3.new(0, -80, 0), params)
        if hit then
            finalPos = hit.Position + Vector3.new(0, 3, 0)
            found = true
            break
        end
    end
    char.HumanoidRootPart.CFrame = CFrame.new(finalPos)
    if found then
        NotifySafe({ title = "Teleport", content = "Teleported to " .. label, duration = 3 })
    else
        NotifySafe({ title = "Teleport", content = "No floor near " .. label .. " — using raw position.", duration = 4 })
    end
end

local function getStaffInfo(player)
    local ok, rank = pcall(function() return player:GetRankInGroup(STAFF_GROUP_ID) end)
    if not ok then return nil end
    if rank < STAFF_RANK_THRESHOLD then return nil end
    local ok2, role = pcall(function() return player:GetRoleInGroup(STAFF_GROUP_ID) end)
    return {
        rank = rank,
        role = ok2 and role or "Staff",
    }
end

local function checkAndAddStaff(player)
    if player == LocalPlayer then return nil end
    if not player.Parent then return nil end
    local info = getStaffInfo(player)
    if info then
        currentStaff[player] = info
        return info
    end
    return nil
end

local function refreshStaffList()
    currentStaff = {}
    local staffCount = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if checkAndAddStaff(p) then staffCount += 1 end
    end
    return staffCount
end

local function setupStaffJoinWatcher()
    if staffOnJoinConnection then
        disconnectTracked(staffOnJoinConnection)
        staffOnJoinConnection = nil
    end
    staffOnJoinConnection = Players.PlayerAdded:Connect(function(player)
        task.wait(1.5)
        local info = checkAndAddStaff(player)
        if info and staffNotifyEnabled then
            NotifySafe({
                title = "Staff Joined",
                content = "A member of staff has joined: " .. player.Name .. " (" .. info.role .. ")",
                duration = 8,
            })
        end
    end)
    track(staffOnJoinConnection)
end

local function onStaffToggleChanged(v)
    staffNotifyEnabled = v
    if v then
        setupStaffJoinWatcher()
        local count = refreshStaffList()
        NotifySafe({
            title = "Staff Monitor",
            content = "Watching for staff. Currently in server: " .. count,
            duration = 5,
        })
    else
        if staffOnJoinConnection then
            disconnectTracked(staffOnJoinConnection)
            staffOnJoinConnection = nil
        end
    end
end

if staffNotifyEnabled then
    task.spawn(function()
        task.wait(0.5)
        setupStaffJoinWatcher()
        currentStaff = {}
        for _, p in ipairs(Players:GetPlayers()) do
            checkAndAddStaff(p)
        end
    end)
end

local function saveCollisions(char)
    originalCollisions = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCollisions[part] = part.CanCollide
        end
    end
end

local function restoreCollisions(char)
    for part, state in pairs(originalCollisions) do
        if part and part.Parent then
            pcall(function() part.CanCollide = state end)
        end
    end
    originalCollisions = {}
end

