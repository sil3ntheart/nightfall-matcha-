local function applyLightingTable(tbl)
    for prop, value in pairs(tbl) do
        pcall(function() Lighting[prop] = value end)
    end
end

local function applyAtmosphereTable(tbl)
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atm or not tbl then return end
    pcall(function()
        if tbl.Density ~= nil then atm.Density = tbl.Density end
        if tbl.Haze    ~= nil then atm.Haze    = tbl.Haze    end
        if tbl.Glare   ~= nil then atm.Glare   = tbl.Glare   end
        if tbl.Color   ~= nil then atm.Color   = tbl.Color   end
        if tbl.Decay   ~= nil then atm.Decay   = tbl.Decay   end
        if tbl.Offset  ~= nil then atm.Offset  = tbl.Offset  end
    end)
end

local function getRainSound()
    local char = LocalPlayer.Character
    if not char then return nil end
    local rh = char:FindFirstChild("rainHandler")
    if not rh then return nil end
    return rh:FindFirstChild("rainSound")
end

local function setRainSoundState(wantPlaying)
    local snd = getRainSound()
    if not snd then return false end
    pcall(function()
        if wantPlaying then
            snd.Looped = true
            if not snd.IsPlaying then snd:Play() end
        else
            if snd.IsPlaying then snd:Stop() end
        end
    end)
    return true
end

local function applyWeatherFlags(rain, redStorm)
    if rainFlag then pcall(function() rainFlag.Value = rain end) end
    if redStormFlag then pcall(function() redStormFlag.Value = redStorm end) end
    if rain then setRainSoundState(true) else setRainSoundState(false) end
end

local function restoreLightingAndAtmosphere()
    for prop, value in pairs(originalLighting) do
        if prop ~= "QualityLevel" then
            pcall(function() Lighting[prop] = value end)
        end
    end
    if originalAtmosphere then applyAtmosphereTable(originalAtmosphere) end
end

local function applyPreset(name)
    local preset = weatherPresets[name]
    if not preset then return end
    applyWeatherFlags(preset.rain, preset.redStorm)
    if preset.lighting   then applyLightingTable(preset.lighting)     end
    if preset.atmosphere then applyAtmosphereTable(preset.atmosphere) end
    currentPresetName = name
end

