local connections = {}
local function track(conn)
    if conn then connections[#connections + 1] = conn end
    return conn
end
local function untrack(conn)
    if not conn then return end
    for i = #connections, 1, -1 do
        if connections[i] == conn then
            table.remove(connections, i)
        end
    end
end
local function disconnectTracked(conn)
    if not conn then return end
    pcall(function() conn:Disconnect() end)
    untrack(conn)
end

local remote = ReplicatedStorage:FindFirstChild("AntiCheatRemote")

if remote
    and type(getgc) == "function"
    and type(debug) == "table"
    and type(debug.getinfo) == "function"
    and type(debug.getupvalue) == "function" then

    local WANTED_UPVALUES = 7

    local function holdsRemote(fn)
        for index = 1, WANTED_UPVALUES do
            local ok, value = pcall(debug.getupvalue, fn, index)
            if ok and value == remote then return true end
        end
        return false
    end

    local function findFlag()
        local ok, objects = pcall(getgc)
        if not ok or type(objects) ~= "table" then return nil end
        for _, value in ipairs(objects) do
            if type(value) == "function" then
                local okInfo, info = pcall(debug.getinfo, value)
                if okInfo and type(info) == "table" and info.nups == WANTED_UPVALUES then
                    if holdsRemote(value) then return value end
                end
            end
        end
        return nil
    end

    local flag = findFlag()
    if flag then
        bypassRan = true
        if type(hookfunction) == "function" then
            pcall(hookfunction, flag, function() end)
        else
            task.spawn(function()
                while keepAliveRunning do
                    for index = 1, WANTED_UPVALUES do
                        local ok, value = pcall(debug.getupvalue, flag, index)
                        if ok then
                            if type(value) == "number" and value > 0 then
                                pcall(debug.setupvalue, flag, index, 0)
                            elseif type(value) == "table" then
                                pcall(table.clear, value)
                            end
                        end
                    end
                    task.wait(1)
                end
            end)
        end
    end
end

