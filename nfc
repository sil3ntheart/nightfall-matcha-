local function healthColor(hp, maxHp)
    if not maxHp or maxHp <= 0 then
        return Color3.fromRGB(0xFF, 0xFF, 0xFF)
    end
    local pct = math.clamp(hp / maxHp, 0, 1)
    local stops = {
        { 1.00, Color3.fromRGB(0x00, 0xCC, 0x00) },
        { 0.75, Color3.fromRGB(0xCC, 0xCC, 0x00) },
        { 0.50, Color3.fromRGB(0xFF, 0x99, 0x00) },
        { 0.25, Color3.fromRGB(0xFF, 0x44, 0x00) },
        { 0.00, Color3.fromRGB(0xCC, 0x00, 0x00) },
    }
    for i = 1, #stops - 1 do
        local a, b = stops[i], stops[i + 1]
        if pct <= a[1] and pct >= b[1] then
            local t = (pct - b[1]) / (a[1] - b[1])
            return a[2]:Lerp(b[2], 1 - t)
        end
    end
    return stops[#stops][2]
end

