local function safeAddTab(name, fn)
    for attempt = 1, 25 do
        if LOOP_STOP then return false end
        local okGet, addTab = pcall(function() return rawget(UI, "AddTab") end)
        if okGet and type(addTab) == "function" then
            local ok, err = pcall(addTab, name, fn)
            if ok then print(">>> registered tab '" .. name .. "'"); return true end
            print(">>> attempt " .. attempt .. " failed: " .. tostring(err))
        end
        task.wait(0.2)
    end
    print(">>> gave up registering '" .. name .. "'")
    return false
end

safeAddTab("^.^meg nfc", function(tab)
    local esp = tab:Section("ESP", "Left")

    esp:Toggle("nf_enabled", "Enable ESP", false, function(on) flags.enabled = on end)
    esp:Toggle("nf_species", "Species", flags.species, function(on) flags.species = on; scheduleSave() end)
    esp:Toggle("nf_name", "Username", flags.name, function(on) flags.name = on; scheduleSave() end)
    esp:Toggle("nf_bloodline", "Bloodline", flags.bloodline, function(on) flags.bloodline = on; scheduleSave() end)
    esp:Tip("Shows the character's bloodline in blue")
    esp:Toggle("nf_health", "Health", flags.health, function(on) flags.health = on; scheduleSave() end)
    esp:Toggle("nf_distance", "Distance", flags.distance, function(on) flags.distance = on; scheduleSave() end)
    esp:Toggle("nf_spell", "Active Spells (Ictus / Motus)", flags.spellESP, function(on) flags.spellESP = on; scheduleSave() end)
    esp:Toggle("nf_vis", "Show Invisible", flags.visESP, function(on) flags.visESP = on; scheduleSave() end)
    esp:Tip("Shows 'Invisible' in red only for players using Invisique")
    esp:SliderInt("nf_maxdist", "Max Distance", 100, 10000, flags.maxDist, function(v) flags.maxDist = v; scheduleSave() end)

    local info = tab:Section("Select Player", "Left")

    local function entryUsername(entry)
        return entry and entry:match("%(([^%(%)]+)%)%s*$") or nil
    end

    local function buildPlayerList()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local dn = p.DisplayName or p.Name
                list[#list+1] = dn .. " (" .. p.Name .. ")"
            end
        end
        table.sort(list)
        if #list == 0 then list[1] = "(no other players)" end
        return list
    end

    local function findPlayerByEntry(entry)
        local username = entryUsername(entry)
        if not username then return nil end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name == username and p ~= LocalPlayer then return p end
        end
        return nil
    end

    local function selectPlayer(p)
        selectedPlayer = p
        selectedName = p and p.Name or nil
    end

    local rebuilding = false   -- ignore callbacks fired by our own list rebuild

    local playerList = buildPlayerList()
    local lastListKey = table.concat(playerList, "\0")

    local dropdown = info:Combo(
        "nf_selected_player", "Player", playerList, 0,
        function(idx, entry)
            if rebuilding then return end
            local p = findPlayerByEntry(entry)
            if p then selectPlayer(p) end     -- ignore nil / placeholder entries
        end
    )
    selectPlayer(findPlayerByEntry(playerList[1]))

    local details = tab:Section("Details", "Right")
    details:InputText("nf_det_user",      "Username",   "-")
    details:InputText("nf_det_species",   "Species",    "-")
    details:InputText("nf_det_bloodline", "Bloodline",  "-")
    details:InputText("nf_det_health",    "Health",     "-")
    details:InputText("nf_det_soul",      "Soul Link",  "-")

    local function refreshDropdown()
        local newList = buildPlayerList()
        local listKey = table.concat(newList, "\0")
        if listKey == lastListKey then return end
        lastListKey = listKey

        -- find the current selection in the new list
        local newIndex = nil
        if selectedName then
            for i, entry in ipairs(newList) do
                if entryUsername(entry) == selectedName then
                    newIndex = i - 1
                    break
                end
            end
        end

        -- selected player left (or nothing selected): fall back to the first entry
        if not newIndex then
            newIndex = 0
            selectPlayer(findPlayerByEntry(newList[1]))
        end

        rebuilding = true
        pcall(function()
            dropdown:Clear()
            for _, name in ipairs(newList) do dropdown:Add(name) end
            dropdown:SetValue(newIndex)
        end)
        rebuilding = false
    end

    task.spawn(function()
        while not LOOP_STOP do
            task.wait(1)
            if playerListDirty then
                playerListDirty = false
                local ok, err = pcall(refreshDropdown)
                if not ok then print(">>> dropdown refresh error: " .. tostring(err)) end
            end
        end
    end)

    -- Always push values (no cache) so a UI reset can never leave the boxes blank
    local function clearDetails()
        uiSet("nf_det_user", "-")
        uiSet("nf_det_species", "-")
        uiSet("nf_det_bloodline", "-")
        uiSet("nf_det_health", "-")
        uiSet("nf_det_soul", "-")
    end

    local function updateDetails()
        local sel = selectedName and Players:FindFirstChild(selectedName)
        if not (sel and sel:IsA("Player")) then clearDetails() return end
        selectedPlayer = sel

        local char = sel.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local gui = char and getTitlesGui(char)

        uiSet("nf_det_user", (sel.DisplayName or sel.Name) .. " (" .. sel.Name .. ")")
        uiSet("nf_det_species", (char and getSpeciesText(char, gui)) or "?")
        uiSet("nf_det_bloodline", (char and getCharacterBloodline(char, gui, sel)) or "?")

        local hpStr = "?"
        if humanoid and humanoid.MaxHealth > 0 then
            hpStr = floor(humanoid.Health) .. " / " .. floor(humanoid.MaxHealth)
        end
        uiSet("nf_det_health", hpStr)

        if isSoulLinked(sel) then
            local partner = findSoulPartner(sel)
            if partner then
                uiSet("nf_det_soul", (partner.DisplayName or partner.Name) .. " (" .. partner.Name .. ")")
            else
                uiSet("nf_det_soul", "Yes")
            end
        else
            uiSet("nf_det_soul", "-")
        end
    end

    task.spawn(function()
        while not LOOP_STOP do
            task.wait(0.5)
            local ok, err = pcall(updateDetails)
            if not ok then print(">>> details loop error: " .. tostring(err)) end
        end
    end)
