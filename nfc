local flags = {
    enabled   = false,
    name      = true,
    bloodline = true,
    species   = true,
    health    = true,
    distance  = true,
    spellESP  = true,
    visESP    = true,
    maxDist   = 2000,
}

local trackedPlayers = {}
local trackedCount   = 0
local espObjects     = {}
local espState       = {}
local selectedPlayer = nil

local OBJECT_IDLE_TIMEOUT = 30

local function clearESPData(player) espState[player] = nil end

local function getState(player)
    local st = espState[player]
    if not st then
        st = { hidden = true, px = {}, py = {}, lastSeen = tick() }
        espState[player] = st
    end
    return st
end

local function isAlive(inst)
    if not inst then return false end
    local ok, parent = pcall(function() return inst.Parent end)
    return ok and parent ~= nil
end

local CONFIG_FILE = "^.^meg_config.json"

local function saveConfig()
    local lines = {}
    for k, v in pairs(flags) do
        if k ~= "enabled" then
            if type(v) == "boolean" then
                lines[#lines+1] = k .. "=B:" .. tostring(v)
            elseif type(v) == "number" then
                lines[#lines+1] = k .. "=N:" .. tostring(v)
            end
        end
    end
    pcall(function() writefile(CONFIG_FILE, table.concat(lines, "\n")) end)
end

local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not raw or raw == "" then return end
    for line in raw:gmatch("[^\n]+") do
        local key, tag, val = line:match("^([^=]+)=([BN]):(.+)$")
        if key and tag and val and flags[key] ~= nil then
            if tag == "B" then flags[key] = (val == "true")
            elseif tag == "N" then
                local n = tonumber(val)
                if n and n == n and n ~= math.huge and n ~= -math.huge then
                    if key == "maxDist" then
                        n = clamp(n, 100, 10000)
                    end
                    flags[key] = n
                end
            end
        end
    end
end

loadConfig()

local savePending = false
local function scheduleSave()
    if savePending then return end
    savePending = true
    task.spawn(function() task.wait(0.4); savePending = false; saveConfig() end)
end

local function newText(size)
    local t = Drawing.new("Text")
    t.Size = size or 14; t.Center = true; t.Outline = true; t.Visible = false
    return t
end

local function removeAll(tbl)
    if not tbl then return end
    for _, d in pairs(tbl) do
        if d and d.Remove then pcall(function() d:Remove() end) end
    end
end

local function createObjects(player)
    local objs = {
        species   = newText(13),
        name      = newText(14),
        bloodline = newText(13),
        spell     = newText(13),
        visible   = newText(13),
        health    = newText(13),
        dist      = newText(12),
    }
    espObjects[player] = objs
    local st = espState[player]
    if st then st.px = {}; st.py = {} end
    return objs
end

local function removeObjects(player)
    removeAll(espObjects[player])
    espObjects[player] = nil
    local st = espState[player]
    if st then st.px = {}; st.py = {}; st.hidden = true end
end

local function trackPlayer(player)
    if player == LocalPlayer then return end
    if trackedPlayers[player] then return end
    if trackedCount >= MAX_TRACKED then return end
    trackedPlayers[player] = true
    trackedCount = trackedCount + 1
end

local function removeESP(player)
    removeObjects(player)
    if trackedPlayers[player] then
        trackedPlayers[player] = nil
        trackedCount = trackedCount - 1
    end
    clearESPData(player)
end

pcall(function() for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end end)
pcall(function() if Players.PlayerAdded then Players.PlayerAdded:Connect(trackPlayer) end end)
pcall(function() if Players.PlayerRemoving then Players.PlayerRemoving:Connect(removeESP) end end)

task.spawn(function()
    while true do
        task.wait(2)
        local ok, list = pcall(function() return Players:GetPlayers() end)
        if ok and list then
            local seen = {}
            for _, p in ipairs(list) do
                seen[p] = true
                if p ~= LocalPlayer and not trackedPlayers[p] then trackPlayer(p) end
            end
            for p in pairs(trackedPlayers) do if not seen[p] then removeESP(p) end end
            for p in pairs(espState) do
                if not seen[p] and not trackedPlayers[p] and not espObjects[p] then espState[p] = nil end
            end
        end
        local now = tick()
        for player in pairs(espObjects) do
            local st = espState[player]
            if st and st.hidden and st.lastSeen and (now - st.lastSeen) > OBJECT_IDLE_TIMEOUT then
                removeObjects(player)
            end
        end
    end
end)

local livingThingsCache = nil

local function getLivingThings()
    local lt = livingThingsCache
    if lt and isAlive(lt) then return lt end
    lt = workspace:FindFirstChild("LivingThings")
    livingThingsCache = lt
    return lt
end

local function getLivingEntry(player)
    local lt = getLivingThings()
    return lt and lt:FindFirstChild(player.Name)
end

local function getCastingFolder(player)
    local entry = getLivingEntry(player)
    return entry and entry:FindFirstChild("CastingSpells")
end

local function getTitlesGui(character)
    if not character then return nil end
    local head = character:FindFirstChild("Head")
    if head then
        local titleAtt = head:FindFirstChild("TitleAtt")
        if titleAtt then
            local gui = titleAtt:FindFirstChild("TitlesGui")
            if gui then return gui end
        end
    end
    local lt = getLivingThings()
    if lt then
        local entry = lt:FindFirstChild(character.Name)
        if entry then
            local titleAtt = entry:FindFirstChild("TitleAtt")
            if titleAtt then
                local gui = titleAtt:FindFirstChild("TitlesGui")
                if gui then return gui end
            end
            local gui = entry:FindFirstChild("TitlesGui")
            if gui then return gui end
        end
    end
    return nil
end

local function getCharacterBloodline(character, gui, player)
    local text = nil
    if gui then
        local label = gui:FindFirstChild("DisplayName")
        if label and label:IsA("TextLabel") then
            text = label.Text
        end
    end
    if not text or text == "" then return nil end

    local first, bloodline = text:match("^(%S+)%s+(.+)$")
    if not bloodline or bloodline == "" then return nil end

    bloodline = bloodline:gsub("%s+$", "")
    if bloodline == "" then return nil end
    if first and first:lower() == bloodline:lower() then return nil end
    if player and bloodline:lower() == player.Name:lower() then return nil end

    return bloodline
end

local function getSpeciesText(character, gui)
    gui = gui or getTitlesGui(character)
    if gui then
        for _, labelName in ipairs({ "SPECIE", "Specie", "Species", "SPECIES" }) do
            local label = gui:FindFirstChild(labelName)
            if label and label:IsA("TextLabel") then
                local text = label.Text
                if text and text ~= "" then return tostring(text) end
            end
        end
    end
    return nil
end

local function getClassColor(character)
    if not character then return nil, nil end
    local statuses = character:FindFirstChild("Statuses")
    if not statuses then return nil, nil end
    for _, name in ipairs(CLASS_PRIORITY) do
        local flag = statuses:FindFirstChild(name)
        if flag and flag:IsA("BoolValue") and flag.Value then
            return name, CLASS_COLORS[name]
        end
    end
    return nil, nil
end

-- [FIX 1] Guard against nil casting
local function findActiveSpells(casting)
    if not casting then return nil end
    local active = {}
    for _, spellName in ipairs(WATCHED_SPELLS) do
        local flag = casting:FindFirstChild(spellName)
        if flag and flag:IsA("BoolValue") and flag.Value then
            active[#active+1] = spellName
        end
    end
    if #active == 0 then return nil end
    return table.concat(active, ", ")
end

local function isInvisible(casting)
    local invis = casting:FindFirstChild("Invisique")
    return invis and invis:IsA("BoolValue") and invis.Value == true
end

local function isSoulLinked(player)
    local entry = getLivingEntry(player)
    if not entry then return false end
    local sl = entry:FindFirstChild("SoulLink")
    return sl and sl:IsA("BoolValue") and sl.Value == true
end

local function findSoulPartner(player, linkedList)
    local linked = linkedList
    if not linked then
        linked = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and isSoulLinked(p) then linked[#linked+1] = p end
        end
    end
    if #linked == 2 then
        if linked[1] == player then return linked[2] end
        if linked[2] == player then return linked[1] end
    end
    return nil
end

local ESP_RENDER_INTERVAL = 1 / 30
local lastESPRender       = 0

local function setVisible(obj, state)
    if obj and obj.Visible ~= state then obj.Visible = state end
end

local function hideESPObject(obj)
    for _, d in pairs(obj) do if d then setVisible(d, false) end end
end

local function hidePlayer(player, st)
    if st.hidden then return end
    local obj = espObjects[player]
    if obj then hideESPObject(obj) end
    st.hidden = true
end

-- [FIX 2] Removed duplicate st.casting assignment (now owned by updateESPData)
local function resolveParts(st, player)
    local char = player.Character
    if not char then
        st.char, st.hrp, st.humanoid = nil, nil, nil
        st.gui = nil; st.casting = nil; st.lastGui = nil; st.guiStamp = nil
        return nil
    end
    if st.char ~= char then
        st.char = char
        st.hrp = nil; st.humanoid = nil; st.gui = nil
        st.casting = nil; st.guiStamp = nil; st.lastGui = nil
        st.speciesText = nil; st.bloodline = nil; st.speciesColor = nil
        st.isInvis = nil; st.spellText = nil; st.hpText = nil
        st.dataStamp = nil
    end
    if not st.hrp then st.hrp = char:FindFirstChild("HumanoidRootPart") end
    if not st.humanoid then st.humanoid = char:FindFirstChildOfClass("Humanoid") end
    return char
end

local DATA_REFRESH_INTERVAL = 0.25

-- [FIX 3] HP moved outside the throttle so damage reflects every frame
local function updateESPData(player, st, char, humanoid, dist, now)
    st.distText = tostring(floor(dist))

    if humanoid and humanoid.MaxHealth > 0 then
        st.hpText = floor(humanoid.Health) .. " / " .. floor(humanoid.MaxHealth)
    else
        st.hpText = nil
    end

    if st.dataStamp and (now - st.dataStamp) < DATA_REFRESH_INTERVAL then
        return
    end
    st.dataStamp = now

    -- re-resolve gui every 3s (text can change mid-game)
    local gui = st.gui
    local needGui = not (gui and isAlive(gui)) or (st.guiStamp and (now - st.guiStamp) > 3)
    if needGui then
        gui = getTitlesGui(char)
        st.gui = gui
        st.guiStamp = now
        st.casting = getCastingFolder(player)  -- refresh casting alongside gui
    end

    if gui ~= st.lastGui or (gui and st.bloodline == nil) then
        st.speciesText = getSpeciesText(char, gui)
        st.bloodline   = getCharacterBloodline(char, gui, player)
        st.lastGui     = gui
        local class, clsColor = getClassColor(char)
        st.speciesClass = class
        st.speciesColor = clsColor
    end

    local casting = st.casting
    if not casting and (flags.spellESP or flags.visESP) then
        casting = getCastingFolder(player)
        st.casting = casting
    end

    if flags.spellESP and casting then
        st.spellText = findActiveSpells(casting) and ("Casting : " .. findActiveSpells(casting)) or nil
    else
        st.spellText = nil
    end

    if flags.visESP and casting then
        st.isInvis = isInvisible(casting)
    else
        st.isInvis = false
    end
end

local function showLine(st, key, d, text, color, x, y)
    if d.Color ~= color then d.Color = color end
    if d.Text ~= text then d.Text = text end
    local px, py = floor(x + 0.5), floor(y + 0.5)
    if st.px[key] ~= px or st.py[key] ~= py then
        d.Position = Vector2_new(px, py)
        st.px[key] = px; st.py[key] = py
    end
    setVisible(d, true)
end

local function renderOnePlayer(player, st, obj, camPos, maxDist, now)
    local char = resolveParts(st, player)
    local hrp, humanoid = st.hrp, st.humanoid

    if not (char and hrp and humanoid and humanoid.Health > 0) then
        hidePlayer(player, st)
        return
    end

    local worldPos = hrp.Position
    local dist = (camPos - worldPos).Magnitude
    if dist > maxDist then
        hidePlayer(player, st)
        return
    end

    local screenPos, onScreen = WorldToScreen(worldPos)
    if not onScreen then
        hidePlayer(player, st)
        return
    end

    st.hidden = false
    st.lastSeen = now

    updateESPData(player, st, char, humanoid, dist, now)

    local rawHeight = clamp(1500 / max(dist, 1), 20, 250)
    local boxHeight = floor(rawHeight / 4) * 4
    local x = screenPos.X
    local baseY = screenPos.Y - boxHeight * 0.5 - 18
    local off = 0

    if flags.species and st.speciesText then
        local c = st.speciesColor or COLORS.species
        showLine(st, "species", obj.species, st.speciesText, c, x, baseY + off); off += 15
    else setVisible(obj.species, false) end

    if flags.name then
        showLine(st, "name", obj.name, player.Name, COLORS.name, x, baseY + off); off += 16
    else setVisible(obj.name, false) end

    if flags.bloodline and st.bloodline then
        showLine(st, "bloodline", obj.bloodline, st.bloodline, COLORS.bloodline, x, baseY + off); off += 15
    else setVisible(obj.bloodline, false) end

    if flags.spellESP and st.spellText then
        showLine(st, "spell", obj.spell, st.spellText, COLORS.spell, x, baseY + off); off += 15
    else setVisible(obj.spell, false) end

    -- Invisible line: only shows when target is invisible
    if flags.visESP and st.isInvis then
        showLine(st, "visible", obj.visible, "Invisible", COLORS.invisible, x, baseY + off)
        off += 15
    else
        setVisible(obj.visible, false)
    end

    if flags.health and st.hpText then
        showLine(st, "health", obj.health, "HP : " .. st.hpText, COLORS.health, x, baseY + off); off += 15
    else setVisible(obj.health, false) end

    if flags.distance and st.distText then
        showLine(st, "dist", obj.dist, st.distText, COLORS.distance, x, baseY + off); off += 15
    else setVisible(obj.dist, false) end
end

local function renderLoop()
    local now = tick()

    if not flags.enabled then
        for player, obj in pairs(espObjects) do
            local st = espState[player]
            if not (st and st.hidden) then
                hideESPObject(obj)
                if st then st.hidden = true end
            end
        end
        return
    end

    if (now - lastESPRender) < ESP_RENDER_INTERVAL then return end
    lastESPRender = now

    local camPos  = Camera.CFrame.Position
    local maxDist = flags.maxDist

    for player in pairs(trackedPlayers) do
        local st = getState(player)
        local obj = espObjects[player]
        if not obj then
            obj = createObjects(player)
        end
        renderOnePlayer(player, st, obj, camPos, maxDist, now)
    end
end

local renderOK = pcall(function()
    RunService.RenderStepped:Connect(function() pcall(renderLoop) end)
end)
if not renderOK then
    task.spawn(function()
        while true do task.wait(); pcall(renderLoop) end
    end)
end

