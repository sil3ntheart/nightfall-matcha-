local function renderLoop()
    if not drawingAvailable then return end
    local now = clock()
    if not espFlags.enabled then
        for player, obj in pairs(espObjects) do
            hideESPObject(obj)
            local st = espState[player]
            if st then st.hidden = true end
        end
        if espFlags.totemESP then
            if (now - lastESPRender) >= ESP_RENDER_INTERVAL then
                lastESPRender = now
                pcall(renderTotems)
            end
        else
            hideAllTotems()
        end
        return
    end
    if (now - lastESPRender) < ESP_RENDER_INTERVAL then return end
    lastESPRender = now

    local camPos = Camera.CFrame.Position
    local maxDist = espFlags.maxDist
    local snapshot = {}
    for player in pairs(trackedPlayers) do
        if player.Parent == nil then
            removeESP(player)
        else
            snapshot[#snapshot + 1] = player
        end
    end

    for _, player in ipairs(snapshot) do
        if player.Parent ~= nil then
            local st = getState(player)
            local wasHidden = st.hidden
            local char = resolveParts(st, player)
            local hrp, humanoid = st.hrp, st.humanoid
            if not (char and hrp and humanoid and humanoid.Health > 0) then
                hidePlayer(player, st)
            else
                local worldPos = hrp.Position
                local dist = (camPos - worldPos).Magnitude
                if dist > maxDist then
                    hidePlayer(player, st)
                else
                    local screenPos, onScreen = toScreen(worldPos)
                    if not onScreen or not screenPos then
                        hidePlayer(player, st)
                    else
                        local obj = espObjects[player]
                        if not obj then obj = createObjects(player); wasHidden = true end
                        updateESPData(player, st, char, humanoid, dist, now, wasHidden)
                        st.hidden = false
                        st.lastSeen = now
                        local boxHeight = clamp(1500 / math.max(dist, 1), 20, 250)
                        local x = screenPos.X
                        local baseY = screenPos.Y - boxHeight * 0.5 - 18
                        local off = 0

                        pcall(function()
                            if espFlags.name then
                                showLine(st, "name", obj.name, player.Name, COLORS.name, x, baseY + off)
                                off += 16
                            else setVisible(obj.name, false) end

                            if espFlags.species and st.species then
                                showLine(st, "species", obj.species, st.species, COLORS.species, x, baseY + off)
                                off += 15
                            else setVisible(obj.species, false) end
                            if espFlags.spellESP and st.spellText then
                                showLine(st, "spell", obj.spell, st.spellText, COLORS.spell, x, baseY + off)
                                off += 15
                            else setVisible(obj.spell, false) end
                            if espFlags.visESP and st.visible == false then
                                showLine(st, "visible", obj.visible, "Invisible",
                                    Color3.fromRGB(0xFF, 0x50, 0x50), x, baseY + off)
                                off += 15
                            else setVisible(obj.visible, false) end
                            if espFlags.bloodline and st.bloodline then
                                showLine(st, "bloodline", obj.bloodline, st.bloodline, COLORS.bloodline, x, baseY + off)
                                off += 15
                            else setVisible(obj.bloodline, false) end
                            if espFlags.health and st.hpPct then
                                local barW = 70
                                local bx = floor(x - barW / 2 + 0.5)
                                local by = floor(baseY + off + 0.5)
                                local fillW = math.max(1, barW * st.hpPct)
                                obj.hpOutline.From = Vector2.new(bx, by)
                                obj.hpOutline.To = Vector2.new(bx + barW, by)
                                setVisible(obj.hpOutline, true)
                                obj.hpBg.From = Vector2.new(bx, by)
                                obj.hpBg.To = Vector2.new(bx + barW, by)
                                setVisible(obj.hpBg, true)
                                obj.hpFill.From = Vector2.new(bx, by)
                                obj.hpFill.To = Vector2.new(bx + fillW, by)
                                obj.hpFill.Color = st.hpColor or Color3.fromRGB(0xFF, 0xFF, 0xFF)
                                setVisible(obj.hpFill, true)
                                off += 8
                            else
                                setVisible(obj.hpOutline, false)
                                setVisible(obj.hpBg, false)
                                setVisible(obj.hpFill, false)
                            end
                            if espFlags.distance and st.distText then
                                showLine(st, "dist", obj.dist, st.distText, COLORS.dist, x, baseY + off)
                                off += 15
                            else setVisible(obj.dist, false) end
                        end)
                    end
                end
            end
        end
    end

    if espFlags.totemESP then
        pcall(renderTotems)
    else
        hideAllTotems()
    end
end

