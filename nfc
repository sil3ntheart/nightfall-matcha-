    esp:Toggle("nf_enabled", "Enable ESP", false, function(on) flags.enabled = on; scheduleSave() end)
    esp:Toggle("nf_species", "Species", flags.species, function(on) flags.species = on; scheduleSave() end)
    esp:Toggle("nf_name", "Username", flags.name, function(on) flags.name = on; scheduleSave() end)
    esp:Toggle("nf_bloodline", "Bloodline", flags.bloodline, function(on) flags.bloodline = on; scheduleSave() end)
    esp:Tip("Shows the character's bloodline in blue")
    esp:Toggle("nf_health", "Health", flags.health, function(on) flags.health = on; scheduleSave() end)
    esp:Toggle("nf_distance", "Distance", flags.distance, function(on) flags.distance = on; scheduleSave() end)
    esp:Toggle("nf_spell", "Active Spells (Ictus / Motus)", flags.spellESP, function(on) flags.spellESP = on; scheduleSave() end)
    esp:Toggle("nf_vis", "Show Invisible", flags.visESP, function(on) flags.visESP = on; scheduleSave() end)
    esp:Tip("Shows 'Invisible' in red only for players using Invisique")
    esp:SliderInt("nf_maxdist", "Max Distance", 100, 10000, flags.maxDist, function(v) flags.maxDist = v; scheduleSave() end)

    local actions = tab:Section("Actions", "Left")
    actions:Button("Reset Defaults", function()
        flags.name = true; flags.bloodline = true; flags.species = true
        flags.health = true; flags.distance = true
        flags.spellESP = true; flags.visESP = true; flags.maxDist = 2000

        -- Push values back into the UI so it doesn't desync from flags
        local keys = {
            name = "nf_name", bloodline = "nf_bloodline", species = "nf_species",
            health = "nf_health", distance = "nf_distance", spellESP = "nf_spell",
            visESP = "nf_vis", maxDist = "nf_maxdist",
        }
        for flag, id in pairs(keys) do uiSet(id, flags[flag]) end

        for _, st in pairs(espState) do resetCaches(st) end
        for _, obj in pairs(espObjects) do
            for _, d in pairs(obj) do d.Visible = false end
        end
        scheduleSave()
        notify("Config reset to defaults", "^.^meg nfc", 3)
    end)
    actions:Button("Save Now", function()
        saveConfig()
        notify("Config saved", "^.^meg nfc", 2)
    end)

    local info = tab:Section("Select Player", "Left")

    local function buildPlayerList()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local dn = p.DisplayName or p.Name
                list[#list+1] = dn .. " (" .. p.Name .. ")"
            end
        end
        table.sort(list)
        return list
    end

    local function findPlayerByEntry(entry)
        if not entry then return nil end
        local username = entry:match("%(([^%(%)]+)%)%s*$")
        if not username then return nil end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name == username then return p end
        end
        return nil
    end

    local playerList = buildPlayerList()
    if #playerList == 0 then playerList = { "(no other players)" } end

    local dropdown = info:Combo(
        "nf_selected_player", "Player", playerList, 0,
        function(idx, entry) selectedPlayer = findPlayerByEntry(entry) end
    )
    selectedPlayer = findPlayerByEntry(playerList[1])

    local details = tab:Section("Details", "Right")
    details:InputText("nf_det_user",      "Username",   "-")
    details:InputText("nf_det_species",   "Species",    "-")
    details:InputText("nf_det_bloodline", "Bloodline",  "-")
    details:InputText("nf_det_health",    "Health",     "-")
    details:InputText("nf_det_soul",      "Soul Link",  "-")

    -- Player list: only rebuilt when PlayerAdded/PlayerRemoving flagged a change
    local lastListKey = ""
    task.spawn(function()
        while not LOOP_STOP do
            task.wait(1)
            if playerListDirty then
                playerListDirty = false
                local newList = buildPlayerList()
                if #newList == 0 then newList = { "(no other players)" } end
                local listKey = table.concat(newList, "\0")
                if listKey ~= lastListKey then
                    lastListKey = listKey
                    local newIndex = 0
                    if selectedPlayer then
                        for i, entry in ipairs(newList) do
                            if findPlayerByEntry(entry) == selectedPlayer then
                                newIndex = i - 1; break
                            end
                        end
                    end
                    pcall(function()
                        dropdown:Clear()
                        for _, name in ipairs(newList) do dropdown:Add(name) end
                        dropdown:SetValue(newIndex)
                    end)
                    if not selectedPlayer then selectedPlayer = findPlayerByEntry(newList[1]) end
                end
            end
        end
    end)

    local lastDetails = {}
    local function setDetail(key, value)
        if lastDetails[key] ~= value then
            lastDetails[key] = value
            uiSet(key, value)
        end
    end

    task.spawn(function()
        while not LOOP_STOP do
            task.wait(0.5)
            local sel = selectedPlayer
            if not sel then
                setDetail("nf_det_user", "-")
                setDetail("nf_det_species", "-")
                setDetail("nf_det_bloodline", "-")
                setDetail("nf_det_health", "-")
                setDetail("nf_det_soul", "-")
            else
                local char = sel.Character
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local gui = char and getTitlesGui(char)
                local dn = sel.DisplayName or sel.Name
                setDetail("nf_det_user", dn .. " (" .. sel.Name .. ")")
                setDetail("nf_det_species", (char and getSpeciesText(char, gui)) or "?")
                setDetail("nf_det_bloodline", (char and getCharacterBloodline(char, gui, sel)) or "?")
                local hpStr = "?"
                if humanoid and humanoid.MaxHealth > 0 then
                    hpStr = floor(humanoid.Health) .. " / " .. floor(humanoid.MaxHealth)
                end
                setDetail("nf_det_health", hpStr)
                if isSoulLinked(sel) then
                    local linked = {}
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and isSoulLinked(p) then linked[#linked+1] = p end
                    end
                    local partner = findSoulPartner(sel, linked)
                    if partner then
                        local pdn = partner.DisplayName or partner.Name
                        setDetail("nf_det_soul", pdn .. " (" .. partner.Name .. ")")
                    else
                        setDetail("nf_det_soul", "Yes")
                    end
                else
                    setDetail("nf_det_soul", "-")
                end
            end
        end
    end)
end)

