    callback = function()
        local TeleportService = game:GetService("TeleportService")
        local HttpService = game:GetService("HttpService")
        local ok, servers = pcall(function()
            return HttpService:JSONDecode(
                game:HttpGet(
                    "https://games.roblox.com/v1/games/" ..
                    game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                )
            )
        end)
        if not ok or not servers or not servers.data then
            NotifySafe({ title = "Server Hop", content = "Failed to fetch server list." })
            return
        end
        local currentJob = game.JobId
        local target = nil
        for _, server in ipairs(servers.data) do
            if server.playing < server.maxPlayers and server.id ~= currentJob then
                target = server.id; break
            end
        end
        if target then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, target, LocalPlayer)
        else
            NotifySafe({ title = "Server Hop", content = "No available servers found." })
        end
    end,
})

