local function applyHitbox(player)
    if player == LocalPlayer or not player.Character then return end
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = player.Character:FindFirstChild("Humanoid")
    if not (rootPart and humanoid and humanoid.Health > 0) then return end

    local box = rootPart:FindFirstChild("CustomHitbox")
    if not box then
        box = Instance.new("Part")
        box.Name = "CustomHitbox"
        box.Size = hitboxSize
        box.Transparency = (hitboxShow and hitboxTransparency or 1)
        box.Color = Color3.fromRGB(255, 0, 0)
        box.CanCollide = false
        box.CanTouch = true
        box.CanQuery = true
        box.Massless = true
        pcall(function() box.CollisionGroup = "MegsHitboxGroup" end)
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rootPart
        weld.Part1 = box
        weld.Parent = box
        
        box.CFrame = rootPart.CFrame
        box.Parent = rootPart
    else
        box.Size = hitboxSize
        box.Transparency = (hitboxShow and hitboxTransparency or 1)
    end
end

