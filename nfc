local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local floor = math.floor
local clamp = math.clamp
local clock = os.clock

local WATCHED_SPELLS = { "Ictus", "Motus" }

local flags = {
    enabled      = false,
    name         = true,
    character    = true,
    species      = true,
    health       = true,
    distance     = true,
    spellESP     = true,
    visESP       = true,
    maxDist      = 2000,
}

local COLORS = {
    name      = Color3.fromRGB(0xFF, 0xFF, 0xFF),
    species   = Color3.fromRGB(0xB4, 0x8C, 0xFF),
    character = Color3.fromRGB(0x30, 0x54, 0x9C),
    health    = Color3.fromRGB(0x78, 0xFF, 0x78),
    dist      = Color3.fromRGB(0xFF, 0xFF, 0xFF),
    spell     = Color3.fromRGB(0xA5, 0x62, 0x00),
    visYes    = Color3.fromRGB(0x50, 0xFF, 0x50),
    visNo     = Color3.fromRGB(0xFF, 0x50, 0x50),
}

-- ============================================================
-- STATE
-- ============================================================
local trackedPlayers = {}
local espObjects = {}
local espState = {}

local OBJECT_IDLE_TIMEOUT = 30

local function clearESPData(player)
    espState[player] = nil
end

local function getState(player)
    local st = espState[player]
    if not st then
        st = { hidden = true, px = {}, py = {} }
        espState[player] = st
    end
    return st
end

local function isAlive(inst)
    local ok, parent = pcall(function() return inst.Parent end)
    return ok and parent ~= nil
end

-- ============================================================
-- CONFIG
-- ============================================================
local CONFIG_FILE = "^.^_meg_config.json"

local function saveConfig()
    local lines = {}
    for k, v in pairs(flags) do
        if k == "enabled" then
        elseif type(v) == "boolean" then
            lines[#lines+1] = k .. "=B:" .. tostring(v)
        elseif type(v) == "number" then
            lines[#lines+1] = k .. "=N:" .. tostring(v)
        end
    end
    pcall(function() writefile(CONFIG_FILE, table.concat(lines, "\n")) end)
end

local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not raw or raw == "" then return end
    for line in raw:gmatch("[^\n]+") do
        local key, tag, val = line:match("^([^=]+)=([CBN]):(.+)$")
        if key and tag and val then
            if flags[key] ~= nil then
                if tag == "B" then
                    flags[key] = (val == "true")
                elseif tag == "N" then
                    local n = tonumber(val)
                    if n then
                        if key == "maxDist" then n = clamp(n, 100, 10000) end
                        flags[key] = n
                    end
                end
            end
        end
    end
end

loadConfig()

local savePending = false
local function scheduleSave()
    if savePending then return end
    savePending = true
    task.spawn(function()
        task.wait(0.4)
        savePending = false
        saveConfig()
    end)
end

-- ============================================================
-- DRAWING OBJECTS
-- ============================================================
local function newText(size)
    local t = Drawing.new("Text")
    t.Size = size or 14
    t.Center = true
    t.Outline = true
    pcall(function() t.Font = Drawing.Fonts.UI end)
    t.Visible = false
    return t
end

local function removeAll(tbl)
    if not tbl then return end
    for _, d in pairs(tbl) do
        if d and d.Remove then pcall(function() d:Remove() end) end
    end
end

local function createObjects(player)
    local objs = {
        name      = newText(14),
        species   = newText(13),
        spell     = newText(13),
        visible   = newText(13),
        character = newText(13),
        health    = newText(13),
        dist      = newText(12),
    }
    espObjects[player] = objs
    local st = espState[player]
    if st then
        st.px = {}
        st.py = {}
        st.hidden = true
    end
    return objs
end

local function removeObjects(player)
    removeAll(espObjects[player])
    espObjects[player] = nil
    local st = espState[player]
    if st then
        st.px = {}
        st.py = {}
        st.hidden = true
    end
end

local function trackPlayer(player)
    if player == LocalPlayer then return end
    trackedPlayers[player] = true
end

local function removeESP(player)
    removeObjects(player)
    trackedPlayers[player] = nil
    clearESPData(player)
end

pcall(function()
    for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end
end)
pcall(function()
    if Players.PlayerAdded then Players.PlayerAdded:Connect(trackPlayer) end
end)
pcall(function()
    if Players.PlayerRemoving then Players.PlayerRemoving:Connect(removeESP) end
end)

task.spawn(function()
    while true do
        task.wait(1)
        local ok, list = pcall(function() return Players:GetPlayers() end)
        if ok and list then
            local seen = {}
            for _, p in ipairs(list) do
                seen[p] = true
                if p ~= LocalPlayer and not trackedPlayers[p] then trackPlayer(p) end
            end
            for p in pairs(trackedPlayers) do
                if not seen[p] then removeESP(p) end
            end
        end

        local now = clock()
        for player in pairs(espObjects) do
            local st = espState[player]
            if st and st.hidden and st.lastSeen and (now - st.lastSeen) > OBJECT_IDLE_TIMEOUT then
                removeObjects(player)
            end
        end
    end
end)

-- ============================================================
-- SHARED LOOKUPS
-- ============================================================
local livingThingsCache = nil

local function getLivingThings()
    if livingThingsCache and isAlive(livingThingsCache) then
        return livingThingsCache
    end
    livingThingsCache = workspace:FindFirstChild("LivingThings")
    return livingThingsCache
end

local function getLivingEntry(player)
    local lt = getLivingThings()
    return lt and lt:FindFirstChild(player.Name)
end

local function getCastingFolder(player)
    local entry = getLivingEntry(player)
    return entry and entry:FindFirstChild("CastingSpells")
end

local function getTitlesGui(character)
    local head = character:FindFirstChild("Head")
    if not head then return nil end
    local titleAtt = head:FindFirstChild("TitleAtt")
    if not titleAtt then return nil end
    return titleAtt:FindFirstChild("TitlesGui")
end

-- ============================================================
-- READERS
-- ============================================================
local function getCharacterSurname(character, gui)
    gui = gui or getTitlesGui(character)
    if not gui then return nil end
    local label = gui:FindFirstChild("DisplayName")
    if not label or not label:IsA("TextLabel") then return nil end
    local text = label.Text
    if text == nil or text == "" then return nil end
    local surname = text:match("(%S+)$")
    return surname or text
end

local function getSpecies(character, gui)
    gui = gui or getTitlesGui(character)
    if not gui then return nil end
    local label = gui:FindFirstChild("SPECIE")
    if not label or not label:IsA("TextLabel") then return nil end
    local text = label.Text
    if text == nil or text == "" then return nil end
    return tostring(text)
end

local function findActiveSpell(casting)
    for _, spellName in ipairs(WATCHED_SPELLS) do
        local flag = casting:FindFirstChild(spellName)
        if flag and flag:IsA("BoolValue") and flag.Value then
            return spellName
        end
    end
    return nil
end

local function isInvisible(casting)
    local invis = casting:FindFirstChild("Invisique")
    return invis and invis:IsA("BoolValue") and invis.Value == true
end

local function isSoulLinked(player)
    local entry = getLivingEntry(player)
    if not entry then return false end
    local sl = entry:FindFirstChild("SoulLink")
    return sl and sl:IsA("BoolValue") and sl.Value == true
end

local function findSoulPartner(player)
    local linked = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isSoulLinked(p) then
            linked[#linked+1] = p
        end
    end
    if #linked == 2 then
        if linked[1] == player then return linked[2] end
        if linked[2] == player then return linked[1] end
    end
    return nil
end

-- ============================================================
-- WorldToScreen normalizer
-- Handles all executor signatures:
--   (Vector2, bool) | (Vector2|nil, bool) | (x, y, bool) | (bool, Vector2)
-- ============================================================
local function toScreen(worldPos)
    local ok, a, b, c = pcall(WorldToScreen, worldPos)
    if not ok then return nil, false end

    if typeof(a) == "Vector2" then
        if b == true then return a, true end
        return nil, false
    end

    if type(a) == "number" and type(b) == "number" then
        if c == true then return Vector2.new(a, b), true end
        return nil, false
    end

    if type(a) == "boolean" and typeof(b) == "Vector2" then
        if a then return b, true end
        return nil, false
    end

    return nil, false
end

-- ============================================================
-- RENDER LOOP
-- ============================================================
local ESP_DATA_INTERVAL = 0.20
local ESP_RENDER_INTERVAL = 1 / 90
local lastESPRender = 0

local function setVisible(obj, state)
    if obj and obj.Visible ~= state then
        obj.Visible = state
    end
end

local function hideESPObject(obj)
    for _, d in pairs(obj) do
        if d then setVisible(d, false) end
    end
end

local function hidePlayer(player, st)
    local obj = espObjects[player]
    if obj then hideESPObject(obj) end
    st.hidden = true
end

local function resolveParts(st, player)
    local char = player.Character
    if not char then
        st.char, st.hrp, st.humanoid, st.gui = nil, nil, nil, nil
        return nil
    end
    if st.char ~= char then
        st.char = char
        st.hrp = nil
        st.humanoid = nil
        st.gui = nil
        st.px = {}
        st.py = {}
        st.nextUpdate = nil
    end
    if not st.hrp then st.hrp = char:FindFirstChild("HumanoidRootPart") end
    if not st.humanoid then st.humanoid = char:FindFirstChildOfClass("Humanoid") end
    return char
end

local function updateESPData(player, st, char, humanoid, dist, now, force)
    if not force and st.nextUpdate and now < st.nextUpdate then
        return
    end
    st.nextUpdate = now + ESP_DATA_INTERVAL * (st.primed and 1 or math.random())
    st.primed = true

    local gui = st.gui
    if not (gui and isAlive(gui)) then
        gui = getTitlesGui(char)
        st.gui = gui
    end
    st.species = getSpecies(char, gui)
    st.surname = getCharacterSurname(char, gui)

    local casting = nil
    if flags.spellESP or flags.visESP then
        casting = getCastingFolder(player)
    end

    st.spell = nil
    st.spellText = nil
    if flags.spellESP and casting then
        st.spell = findActiveSpell(casting)
        if st.spell then st.spellText = "Casting : " .. st.spell end
    end

    st.visible = true
    if flags.visESP and casting and isInvisible(casting) then
        st.visible = false
    end

    if humanoid then
        st.hp = floor(humanoid.Health)
        st.maxHp = floor(humanoid.MaxHealth)
        st.hpText = st.hp .. " / " .. st.maxHp
    else
        st.hpText = nil
    end

    st.distText = tostring(floor(dist))
end

local function showLine(st, key, d, text, color, x, y)
    if d.Color ~= color then d.Color = color end
    if d.Text ~= text then d.Text = text end
    local px, py = floor(x + 0.5), floor(y + 0.5)
    if st.px[key] ~= px or st.py[key] ~= py then
        d.Position = Vector2.new(px, py)
        st.px[key] = px
        st.py[key] = py
    end
    setVisible(d, true)
end

local function renderLoop()
    local now = clock()

    if not flags.enabled then
        for player, obj in pairs(espObjects) do
            hideESPObject(obj)
            local st = espState[player]
            if st then st.hidden = true end
        end
        return
    end

    if (now - lastESPRender) < ESP_RENDER_INTERVAL then
        return
    end
    lastESPRender = now

    local camPos = Camera.CFrame.Position
    local maxDist = flags.maxDist

    local snapshot = {}
    for player in pairs(trackedPlayers) do
        snapshot[#snapshot+1] = player
    end

    for _, player in ipairs(snapshot) do
        pcall(function()
            if player.Parent == nil then return end

            local st = getState(player)
            local wasHidden = st.hidden

            local char = resolveParts(st, player)
            local hrp, humanoid = st.hrp, st.humanoid

            if not (char and hrp and humanoid and humanoid.Health > 0) then
                hidePlayer(player, st)
                return
            end

            local worldPos = hrp.Position
            local dist = (camPos - worldPos).Magnitude
            if dist > maxDist then
                hidePlayer(player, st)
                return
            end

            local screenPos, onScreen = toScreen(worldPos)
            if not onScreen or not screenPos then
                hidePlayer(player, st)
                return
            end

            local obj = espObjects[player]
            if not obj then
                obj = createObjects(player)
                wasHidden = true
            end

            updateESPData(player, st, char, humanoid, dist, now, wasHidden)

            st.hidden = false
            st.lastSeen = now

            local boxHeight = clamp(1500 / math.max(dist, 1), 20, 250)
            local x = screenPos.X
            local baseY = screenPos.Y - boxHeight * 0.5 - 18
            local off = 0

            if flags.name then
                showLine(st, "name", obj.name, player.Name, COLORS.name, x, baseY + off)
                off += 16
            else
                setVisible(obj.name, false)
            end

            if flags.species and st.species then
                showLine(st, "species", obj.species, st.species, COLORS.species, x, baseY + off)
                off += 15
            else
                setVisible(obj.species, false)
            end

            if flags.spellESP and st.spellText then
                showLine(st, "spell", obj.spell, st.spellText, COLORS.spell, x, baseY + off)
                off += 15
            else
                setVisible(obj.spell, false)
            end

            if flags.visESP then
                local isVis = st.visible
                showLine(st, "visible", obj.visible,
                    isVis and "Visible : Yes" or "Visible : No",
                    isVis and COLORS.visYes or COLORS.visNo,
                    x, baseY + off)
                off += 15
            else
                setVisible(obj.visible, false)
            end

            if flags.character and st.surname then
                showLine(st, "character", obj.character, st.surname, COLORS.character, x, baseY + off)
                off += 15
            else
                setVisible(obj.character, false)
            end

            if flags.health and st.hpText then
                showLine(st, "health", obj.health, st.hpText, COLORS.health, x, baseY + off)
                off += 15
            else
                setVisible(obj.health, false)
            end

            if flags.distance and st.distText then
                showLine(st, "dist", obj.dist, st.distText, COLORS.dist, x, baseY + off)
                off += 15
            else
                setVisible(obj.dist, false)
            end
        end)
    end
end

local renderOK = pcall(function()
    RunService.RenderStepped:Connect(function()
        pcall(renderLoop)
    end)
end)
if not renderOK then
    task.spawn(function()
        while true do
            task.wait()
            pcall(renderLoop)
        end
    end)
end

