    name = "Notify on Staff Join", flag = "StaffNotify", value = false,
    callback = onStaffToggleChanged,
})

settingsTab:CreateButton({
    name = "List Current Staff in Server",
    callback = function()
        local entries = {}
        local staffCount = 0

        for _, p in ipairs(Players:GetPlayers()) do
            local ok, rank = pcall(function() return p:GetRankInGroup(STAFF_GROUP_ID) end)
            if ok and rank >= 2 then
                local ok2, role = pcall(function() return p:GetRoleInGroup(STAFF_GROUP_ID) end)
                local isStaff = rank >= STAFF_RANK_THRESHOLD
                entries[#entries+1] = {
                    displayName = p.DisplayName,
                    username    = p.Name,
                    rank        = rank,
                    role        = ok2 and role or "Unknown",
                    isStaff     = isStaff,
                }
                if isStaff then staffCount += 1 end
            end
        end

        if #entries == 0 then
            NotifySafe({ title = "Staff Monitor", content = "No staff in server currently.", duration = 4 })
            return
        end

        table.sort(entries, function(a, b) return a.rank > b.rank end)

        local header
        if staffCount == 0 then
            header = "Staff in server: 0 (" .. #entries .. " below-threshold member(s) present)"
        else
            header = "Staff in server: " .. staffCount
        end

        local lines = { header, "" }
        for _, e in ipairs(entries) do
            local marker = e.isStaff and "★" or "·"
            lines[#lines+1] = string.format("%s %s — Rank %d: %s",
                marker, e.displayName, e.rank, e.role)
        end

        NotifySafe({ title = "Staff Monitor", content = table.concat(lines, "\n"), duration = 12 })
    end,
})

