local function toScreen(worldPos)
    if not Camera then return nil, false end
    local ok, v, onScreen = pcall(function()
        return Camera:WorldToViewportPoint(worldPos)
    end)
    if not ok or typeof(v) ~= "Vector3" or onScreen ~= true then
        return nil, false
    end
    local vp = Camera.ViewportSize
    if v.X < 0 or v.Y < 0 or v.X > vp.X or v.Y > vp.Y then
        return nil, false
    end
    return Vector2.new(v.X, v.Y), true
end

