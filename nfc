-- ============================================================
-- ^.^ meg ESP - Matcha version
-- Per-player lines: Username, Species, Spell, Visible, Surname, Health, Distance
-- Visible: green "Visible : Yes" / red "Visible : No" (based on Invisique)
-- ============================================================

local Nova = loadstring(httpget("https://raw.githubusercontent.com/Martinikaws/Nova/main/Nova.lua"))() or _G.Nova

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local WATCHED_SPELLS = { "Ictus", "Motus" }

local flags = {
    enabled      = false,
    name         = true,
    character    = true,
    species      = true,
    health       = true,
    distance     = true,
    spellESP     = true,
    visESP       = true,

    maxDist      = 2000,
    nameColor    = Color3.fromRGB(255, 255, 255),
    charColor    = Color3.fromRGB(255, 200, 100),
    speciesColor = Color3.fromRGB(180, 140, 255),
    healthColor  = Color3.fromRGB(120, 255, 120),
    distColor    = Color3.fromRGB(255, 255, 255),
    spellColor   = Color3.fromRGB(255, 80, 80),
    visYesColor  = Color3.fromRGB(80, 255, 80),
    visNoColor   = Color3.fromRGB(255, 80, 80),
}

local espObjects = {}
local selectedPlayer = nil

local CONFIG_FILE = "^.^_meg_config.json"

local function colorToStr(c)
    return string.format("%d,%d,%d",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

local function strToColor(s)
    local r, g, b = s:match("^(%d+),(%d+),(%d+)$")
    if not r then return nil end
    return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
end

local function saveConfig()
    local lines = {}
    for k, v in pairs(flags) do
        if k == "enabled" then
        elseif typeof(v) == "Color3" then
            lines[#lines+1] = k .. "=C:" .. colorToStr(v)
        elseif type(v) == "boolean" then
            lines[#lines+1] = k .. "=B:" .. tostring(v)
        elseif type(v) == "number" then
            lines[#lines+1] = k .. "=N:" .. tostring(v)
        end
    end
    pcall(function() writefile(CONFIG_FILE, table.concat(lines, "\n")) end)
end

local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not raw or raw == "" then return end
    for line in raw:gmatch("[^\n]+") do
        local key, tag, val = line:match("^([^=]+)=([CBN]):(.+)$")
        if key and tag and val then
            if flags[key] ~= nil then
                if tag == "C" then
                    local c = strToColor(val)
                    if c then flags[key] = c end
                elseif tag == "B" then
                    flags[key] = (val == "true")
                elseif tag == "N" then
                    flags[key] = tonumber(val) or flags[key]
                end
            end
        end
    end
end

loadConfig()

local savePending = false
local function scheduleSave()
    if savePending then return end
    savePending = true
    task.spawn(function()
        task.wait(0.4)
        savePending = false
        saveConfig()
    end)
end

local function newText(size)
    local t = Drawing.new("Text")
    t.Size = size or 14
    t.Center = true
    t.Outline = true
    t.Visible = false
    return t
end

local function removeAll(tbl)
    if not tbl then return end
    for _, d in pairs(tbl) do
        if d and d.Remove then pcall(function() d:Remove() end) end
    end
end

local function createESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end
    espObjects[player] = {
        name      = newText(14),
        species   = newText(13),
        spell     = newText(13),
        visible   = newText(13),
        character = newText(13),
        health    = newText(13),
        dist      = newText(12),
    }
end

local function removeESP(player)
    if not espObjects[player] then return end
    removeAll(espObjects[player])
    espObjects[player] = nil
end

pcall(function()
    for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
end)
pcall(function()
    if Players.PlayerAdded then Players.PlayerAdded:Connect(createESP) end
end)
pcall(function()
    if Players.PlayerRemoving then
        Players.PlayerRemoving:Connect(function(player)
            removeESP(player)
            clearESPData(player)
        end)
    end
end)

task.spawn(function()
    while true do
        task.wait(1)
        local ok, list = pcall(function() return Players:GetPlayers() end)
        if ok and list then
            local seen = {}
            for _, p in ipairs(list) do
                seen[p] = true
                if not espObjects[p] and p ~= LocalPlayer then createESP(p) end
            end
            for p in pairs(espObjects) do
                if not seen[p] then removeESP(p) end
            end
        end
    end
end)

-- ============================================================
-- READERS
-- ============================================================
local function getTitlesGui(character)
    local head = character:FindFirstChild("Head")
    if not head then return nil end
    local titleAtt = head:FindFirstChild("TitleAtt")
    if not titleAtt then return nil end
    return titleAtt:FindFirstChild("TitlesGui")
end

local function getCharacterSurname(character)
    local gui = getTitlesGui(character)
    if not gui then return nil end
    local label = gui:FindFirstChild("DisplayName")
    if not label or not label:IsA("TextLabel") then return nil end
    local text = label.Text
    if text == nil or text == "" then return nil end
    local surname = text:match("(%S+)$")
    return surname or text
end

local function getSpecies(character)
    local gui = getTitlesGui(character)
    if not gui then return nil end
    local label = gui:FindFirstChild("SPECIE")
    if not label or not label:IsA("TextLabel") then return nil end
    local text = label.Text
    if text == nil or text == "" then return nil end
    return tostring(text)
end

-- ============================================================
-- ACTIVE SPELL READER (throttled per-player)
-- ============================================================
local spellCache = {}

local function refreshSpellCacheFor(player)
    local lt = workspace:FindFirstChild("LivingThings")
    if not lt then return nil end
    local entry = lt:FindFirstChild(player.Name)
    if not entry then return nil end
    local casting = entry:FindFirstChild("CastingSpells")
    if not casting then return nil end

    for _, spellName in ipairs(WATCHED_SPELLS) do
        local flag = casting:FindFirstChild(spellName)
        if flag and flag:IsA("BoolValue") and flag.Value then
            return spellName
        end
    end
    return nil
end

local function getWatchedSpell(player)
    local now = tick()
    local cached = spellCache[player]
    if cached and (now - cached.time) < 0.25 then
        return cached.spell
    end
    local spell = refreshSpellCacheFor(player)
    spellCache[player] = { spell = spell, time = now }
    return spell
end

-- ============================================================
-- PER-PLAYER VISIBILITY READER (throttled)
-- ============================================================
local visCache = {}

local function refreshVisFor(player)
    local lt = workspace:FindFirstChild("LivingThings")
    if not lt then return true end
    local entry = lt:FindFirstChild(player.Name)
    if not entry then return true end
    local casting = entry:FindFirstChild("CastingSpells")
    if not casting then return true end
    local invis = casting:FindFirstChild("Invisique")
    if invis and invis:IsA("BoolValue") and invis.Value then
        return false
    end
    return true
end

local function isPlayerVisible(player)
    local now = tick()
    local cached = visCache[player]
    if cached and (now - cached.time) < 0.25 then
        return cached.visible
    end
    local visible = refreshVisFor(player)
    visCache[player] = { visible = visible, time = now }
    return visible
end

-- ============================================================
-- SOUL LINK READER + PAIR INFERENCE
-- ============================================================
local function isSoulLinked(player)
    local lt = workspace:FindFirstChild("LivingThings")
    if not lt then return false end
    local entry = lt:FindFirstChild(player.Name)
    if not entry then return false end
    local sl = entry:FindFirstChild("SoulLink")
    return sl and sl:IsA("BoolValue") and sl.Value == true
end

local function findSoulPartner(player)
    local linked = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isSoulLinked(p) then
            linked[#linked+1] = p
        end
    end
    if #linked == 2 then
        if linked[1] == player then return linked[2] end
        if linked[2] == player then return linked[1] end
    end
    return nil
end

-- ============================================================
-- RENDER LOOP
-- ============================================================
-- ============================================================
-- OPTIMIZED RENDER LOOP
-- Expensive player-data reads are throttled; screen positioning
-- still updates every frame for smooth ESP movement.
-- ============================================================

local ESP_DATA_INTERVAL = 0.20 -- 5 updates/sec for text/data
local espDataCache = {}

local function setVisible(obj, state)
    if obj and obj.Visible ~= state then
        obj.Visible = state
    end
end

local function hideESPObject(obj)
    for _, d in pairs(obj) do
        if d then setVisible(d, false) end
    end
end

local function updateESPData(player, char, humanoid, now)
    local cache = espDataCache[player]
    if not cache then
        cache = {}
        espDataCache[player] = cache
    end

    if cache.lastUpdate and (now - cache.lastUpdate) < ESP_DATA_INTERVAL then
        return cache
    end

    cache.lastUpdate = now

    -- These GUI searches are now done only 5 times/sec instead of
    -- once every rendered frame.
    cache.species = getSpecies(char)
    cache.surname = getCharacterSurname(char)

    if flags.spellESP then
        cache.spell = getWatchedSpell(player)
    else
        cache.spell = nil
    end

    if flags.visESP then
        cache.visible = isPlayerVisible(player)
    else
        cache.visible = true
    end

    if humanoid then
        cache.hp = math.floor(humanoid.Health)
        cache.maxHp = math.floor(humanoid.MaxHealth)
    end

    return cache
end

local function clearESPData(player)
    espDataCache[player] = nil
    spellCache[player] = nil
    visCache[player] = nil
end

-- Visual refresh limiter.
-- The game can render at 180+ FPS, but the ESP does not need to
-- reposition every Drawing object on every single rendered frame.
-- 90 Hz keeps it responsive while cutting a large amount of work.
local ESP_RENDER_INTERVAL = 1 / 90
local lastESPRender = 0

local function renderLoop()
    local now = tick()

    if flags.enabled and (now - lastESPRender) < ESP_RENDER_INTERVAL then
        return
    end

    if flags.enabled then
        lastESPRender = now
    end
    if not flags.enabled then
        for _, obj in pairs(espObjects) do
            hideESPObject(obj)
        end
        return
    end

    local camPos = Camera.CFrame.Position
    local maxDist = flags.maxDist

    for player, obj in pairs(espObjects) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if not (hrp and humanoid and humanoid.Health > 0) then
            hideESPObject(obj)
            continue
        end

        local worldPos = hrp.Position
        local offset = camPos - worldPos
        local dist = offset.Magnitude

        -- Do the cheap distance test before WorldToScreen and all
        -- expensive text/data work.
        if dist > maxDist then
            hideESPObject(obj)
            continue
        end

        local screenPos, onScreen = WorldToScreen(worldPos)

        if not onScreen then
            hideESPObject(obj)
            continue
        end

        local data = updateESPData(player, char, humanoid, now)

        local boxHeight = math.clamp(1500 / math.max(dist, 1), 20, 250)
        local topY = screenPos.Y - boxHeight * 0.5
        local lineOffset = 0
        local textAnchorY = topY - 18

        -- Username
        if obj.name then
            if flags.name then
                if obj.name.Color ~= flags.nameColor then obj.name.Color = flags.nameColor end
                obj.name.Position = Vector2.new(screenPos.X, textAnchorY + lineOffset)
                if obj.name.Text ~= player.Name then obj.name.Text = player.Name end
                setVisible(obj.name, true)
                lineOffset += 16
            else
                setVisible(obj.name, false)
            end
        end

        -- Species
        if obj.species then
            if flags.species and data.species then
                if obj.species.Color ~= flags.speciesColor then obj.species.Color = flags.speciesColor end
                obj.species.Position = Vector2.new(screenPos.X, textAnchorY + lineOffset)
                if obj.species.Text ~= data.species then obj.species.Text = data.species end
                setVisible(obj.species, true)
                lineOffset += 15
            else
                setVisible(obj.species, false)
            end
        end

        -- Active spell
        if obj.spell then
            if flags.spellESP and data.spell then
                if obj.spell.Color ~= flags.spellColor then obj.spell.Color = flags.spellColor end
                obj.spell.Position = Vector2.new(screenPos.X, textAnchorY + lineOffset)
                local spellText = "Casting : " .. data.spell
                if obj.spell.Text ~= spellText then obj.spell.Text = spellText end
                setVisible(obj.spell, true)
                lineOffset += 15
            else
                setVisible(obj.spell, false)
            end
        end

        -- Visibility
        if obj.visible then
            if flags.visESP then
                local visibleText = data.visible and "Visible : Yes" or "Visible : No"
                local wantedColor = data.visible and flags.visYesColor or flags.visNoColor
                if obj.visible.Color ~= wantedColor then obj.visible.Color = wantedColor end
                obj.visible.Position = Vector2.new(screenPos.X, textAnchorY + lineOffset)
                if obj.visible.Text ~= visibleText then obj.visible.Text = visibleText end
                setVisible(obj.visible, true)
                lineOffset += 15
            else
                setVisible(obj.visible, false)
            end
        end

        -- Surname
        if obj.character then
            if flags.character and data.surname then
                if obj.character.Color ~= flags.charColor then obj.character.Color = flags.charColor end
                obj.character.Position = Vector2.new(screenPos.X, textAnchorY + lineOffset)
                if obj.character.Text ~= data.surname then obj.character.Text = data.surname end
                setVisible(obj.character, true)
                lineOffset += 15
            else
                setVisible(obj.character, false)
            end
        end

        -- Health
        if obj.health then
            if flags.health then
                if obj.health.Color ~= flags.healthColor then obj.health.Color = flags.healthColor end
                obj.health.Position = Vector2.new(screenPos.X, textAnchorY + lineOffset)
                local hpText = data.hp .. " / " .. data.maxHp
                if obj.health.Text ~= hpText then obj.health.Text = hpText end
                setVisible(obj.health, true)
                lineOffset += 15
            else
                setVisible(obj.health, false)
            end
        end

        -- Distance remains frame-based so it stays smooth.
        if obj.dist then
            if flags.distance then
                if obj.dist.Color ~= flags.distColor then obj.dist.Color = flags.distColor end
                obj.dist.Position = Vector2.new(screenPos.X, textAnchorY + lineOffset)
                local distText = tostring(math.floor(dist))
                if obj.dist.Text ~= distText then obj.dist.Text = distText end
                setVisible(obj.dist, true)
                lineOffset += 15
            else
                setVisible(obj.dist, false)
            end
        end
    end
end

local renderOK = pcall(function()
    RunService.RenderStepped:Connect(renderLoop)
end)
if not renderOK then
    task.spawn(function()
        while true do
            task.wait()
            pcall(renderLoop)
        end
    end)
end

