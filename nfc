local function resolveParts(st, player)
    local char = player.Character
    if not char then
        st.char, st.hrp, st.humanoid, st.gui = nil, nil, nil, nil
        return nil
    end
    if st.char ~= char then
        st.char = char
        st.hrp = nil; st.humanoid = nil; st.gui = nil
        st.px = {}; st.py = {}; st.nextUpdate = nil
        st.species = nil; st.bloodline = nil; st.spellText = nil
        st.visible = true
        st.hp = nil; st.maxHp = nil; st.hpColor = nil; st.hpPct = nil
    end
    if not st.hrp then st.hrp = char:FindFirstChild("HumanoidRootPart") end
    if not st.humanoid then st.humanoid = char:FindFirstChildOfClass("Humanoid") end
    return char
end

local function updateESPData(player, st, char, humanoid, dist, now, force)
    if not force and st.nextUpdate and now < st.nextUpdate then return end
    st.nextUpdate = now + ESP_DATA_INTERVAL

    local gui = st.gui
    if not (gui and isAlive(gui)) then
        gui = getTitlesGui(char)
        st.gui = gui
    end
    st.species = getSpecies(char, gui)
    st.bloodline = getBloodline(char, gui)

    st.spell = getAbilityEquipped(char)
    st.spellText = st.spell

    st.visible = true
    if espFlags.visESP then
        local casting = getCastingFolder(player)
        if casting and isInvisible(casting) then st.visible = false end
    end

    if humanoid then
        st.hp = floor(humanoid.Health)
        st.maxHp = floor(humanoid.MaxHealth)
        st.hpColor = healthColor(st.hp, st.maxHp)
        st.hpPct = st.maxHp > 0 and math.clamp(st.hp / st.maxHp, 0, 1) or 0
    else
        st.hp = nil; st.maxHp = nil; st.hpColor = nil; st.hpPct = nil
    end

    st.distText = tostring(floor(dist))
end

local function showLine(st, key, d, text, color, x, y)
    if d.Color ~= color then d.Color = color end
    if d.Text ~= text then d.Text = text end
    local px, py = floor(x + 0.5), floor(y + 0.5)
    if st.px[key] ~= px or st.py[key] ~= py then
        d.Position = Vector2.new(px, py)
        st.px[key] = px; st.py[key] = py
    end
    setVisible(d, true)
end

local function renderTotems()
    local map = workspace:FindFirstChild("map")
    local totemFolder = map and map:FindFirstChild("Totems")
    if not totemFolder then
        for part in pairs(totemObjects) do
            removeTotemObjects(part)
        end
        return
    end
    local activeTotems = {}
    local camPos = Camera.CFrame.Position
    for _, totem in ipairs(totemFolder:GetChildren()) do
        if totem:IsA("BasePart") then
            activeTotems[totem] = true
            local objs = totemObjects[totem]
            if not objs then objs = createTotemObjects(totem) end
            objs.label.Color = COLORS.totem
            local vp, onScreen = toScreen(totem.Position)
            if onScreen and vp then
                local dist = (camPos - totem.Position).Magnitude
                objs.label.Text = string.format("Hollowed Totem (%d)", floor(dist))
                objs.label.Position = vp - Vector2.new(0, 20)
                objs.label.Visible = true
            else
                objs.label.Visible = false
            end
        end
    end
    for part in pairs(totemObjects) do
        if not activeTotems[part] then
            removeTotemObjects(part)
        end
    end
end

