UI.AddTab("^.^meg nfc", function(tab)
    if _G.__meg_nfc_tab_built then return end
    _G.__meg_nfc_tab_built = true

    local esp = tab:Section("ESP", "Left")

    esp:Toggle("nf_enabled", "Enable ESP", false, function(on) flags.enabled = on; scheduleSave() end)
    esp:Toggle("nf_name", "Username", flags.name, function(on) flags.name = on; scheduleSave() end)
    esp:Toggle("nf_species", "Species", flags.species, function(on) flags.species = on; scheduleSave() end)
    esp:Toggle("nf_character", "Surname", flags.character, function(on) flags.character = on; scheduleSave() end)
    esp:Tip("Shows only the character's surname")
    esp:Toggle("nf_health", "Health", flags.health, function(on) flags.health = on; scheduleSave() end)
    esp:Toggle("nf_distance", "Distance", flags.distance, function(on) flags.distance = on; scheduleSave() end)
    esp:Toggle("nf_spell", "Active Spell (Ictus / Motus)", flags.spellESP, function(on) flags.spellESP = on; scheduleSave() end)
    esp:Tip("Shows 'Casting : Ictus' or 'Casting : Motus' under Species when active")
    esp:Toggle("nf_vis", "Visible (Yes / No)", flags.visESP, function(on) flags.visESP = on; scheduleSave() end)
    esp:Tip("Per-player: shows Visible : Yes (green) or Visible : No (red)")
    esp:SliderInt("nf_maxdist", "Max Distance", 100, 10000, flags.maxDist, function(v) flags.maxDist = v; scheduleSave() end)

    local actions = tab:Section("Actions", "Left")
    actions:Button("Reset Defaults", function()
        flags.name = true
        flags.character = true
        flags.species = true
        flags.health = true
        flags.distance = true
        flags.spellESP = true
        flags.visESP = true
        flags.maxDist = 2000
        scheduleSave()
        notify("Config reset to defaults", "^.^meg nfc", 3)
    end)
    actions:Button("Save Now", function()
        saveConfig()
        notify("Config saved", "^.^meg nfc", 2)
    end)

    local info = tab:Section("Select Player", "Left")

    -- ========================================================
    -- SELECTION STATE
    -- Track selection by USERNAME string, not Player object.
    -- ========================================================
    local selectedName = nil
    local comboCallbackFires = false
    local lastListKey = ""

    local function buildPlayerList()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local dn = p.DisplayName or p.Name
                list[#list+1] = dn .. " (" .. p.Name .. ")"
            end
        end
        table.sort(list)
        return list
    end

    local function usernameFromEntry(entry)
        if type(entry) ~= "string" then return nil end
        local username = entry:match("%((.-)%)%s*$")
        return username
    end

    local function playerFromUsername(username)
        if not username then return nil end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name == username then return p end
        end
        return nil
    end

    -- ========================================================
    -- DROPDOWN
    -- Accept both callback signatures: (idx, entry) and (entry).
    -- ========================================================
    local playerList = buildPlayerList()
    if #playerList == 0 then playerList = { "(no other players)" } end

    local function onComboChanged(a, b)
        if comboCallbackFires then return end
        local entry
        if type(a) == "number" then
            entry = b
        elseif type(a) == "string" then
            entry = a
        elseif type(b) == "string" then
            entry = b
        end
        local uname = usernameFromEntry(entry)
        if uname and playerFromUsername(uname) then
            selectedName = uname
        else
            selectedName = nil
        end
    end

    local dropdown = info:Combo(
        "nf_selected_player", "Player", playerList, 0, onComboChanged
    )

    selectedName = usernameFromEntry(playerList[1])
    lastListKey = table.concat(playerList, ",")

    -- ========================================================
    -- DETAILS FIELDS
    -- ========================================================
    local details = tab:Section("Details", "Right")

    details:InputText("nf_det_user",    "Username",   "—")
    details:InputText("nf_det_species", "Species",    "—")
    details:InputText("nf_det_surname", "Surname",    "—")
    details:InputText("nf_det_health",  "Health",     "—")
    details:InputText("nf_det_soul",    "Soul Link",  "—")

    local function setDetail(key, value)
        pcall(function() UI.SetValue(key, value) end)
    end

    -- ========================================================
    -- LIST REFRESH (0.5s)
    -- ========================================================
    task.spawn(function()
        while true do
            task.wait(0.5)
            pcall(function()
                local newList = buildPlayerList()
                if #newList == 0 then newList = { "(no other players)" } end
                local newKey = table.concat(newList, ",")
                if newKey == lastListKey then return end
                lastListKey = newKey

                local desired = selectedName
                if not desired or not playerFromUsername(desired) then
                    desired = usernameFromEntry(newList[1])
                end

                comboCallbackFires = true
                local ok = pcall(function()
                    dropdown:Clear()
                    for _, name in ipairs(newList) do dropdown:Add(name) end
                    local idx = 0
                    if desired then
                        for i, entry in ipairs(newList) do
                            if usernameFromEntry(entry) == desired then
                                idx = i - 1
                                break
                            end
                        end
                    end
                    dropdown:SetValue(idx)
                end)
                comboCallbackFires = false

                selectedName = desired
            end)
        end
    end)

    -- ========================================================
    -- DETAILS UPDATER (0.25s)
    -- Resolves selectedName -> Player each tick. Writes unconditionally.
    -- ========================================================
    task.spawn(function()
        while true do
            task.wait(0.25)
            pcall(function()
                local username = selectedName
                local sel = username and playerFromUsername(username) or nil

                if not sel then
                    if username and not playerFromUsername(username) then
                        selectedName = nil
                    end
                    setDetail("nf_det_user", "—")
                    setDetail("nf_det_species", "—")
                    setDetail("nf_det_surname", "—")
                    setDetail("nf_det_health", "—")
                    setDetail("nf_det_soul", "—")
                    return
                end

                local char = sel.Character
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local gui = char and getTitlesGui(char)

                local dn = sel.DisplayName or sel.Name
                setDetail("nf_det_user", dn .. " (" .. sel.Name .. ")")
                setDetail("nf_det_species", (char and getSpecies(char, gui)) or "?")
                setDetail("nf_det_surname", (char and getCharacterSurname(char, gui)) or "?")

                local hpStr = "?"
                if humanoid then
                    hpStr = floor(humanoid.Health) .. " / " .. floor(humanoid.MaxHealth)
                end
                setDetail("nf_det_health", hpStr)

                if isSoulLinked(sel) then
                    local partner = findSoulPartner(sel)
                    if partner then
                        local pdn = partner.DisplayName or partner.Name
                        setDetail("nf_det_soul", pdn .. " (" .. partner.Name .. ")")
                    else
                        setDetail("nf_det_soul", "Yes")
                    end
                else
                    setDetail("nf_det_soul", "")
                end
            end)
        end
    end)
end)

